@model ElectronicsShop.Models.DashboardViewModel
@{
    ViewData["Title"] = "Trang quản trị";
}
<style>
    .db-page {
        --es-blue: #1E4FBF;
        --es-blue-dark: #0F2F7A;
        --es-navy: #0B1F4B;
        --es-red: #E0282E;
        --es-bg: #F3F5F9;
        --es-card: #FFFFFF;
        --es-text: #1F2937;
        --es-muted: #6B7280;
        --es-border: #E5E7EB;
        --es-success: #15803D;
        padding: 35px 0 60px;
        background: var(--es-bg);
        min-height: calc(100vh - 100px);
    }
    .db-eyebrow {
        font-size: 12px;
        letter-spacing: 1.8px;
        text-transform: uppercase;
        color: var(--es-red);
        font-weight: 700;
    }
    .db-title {
        font-weight: 800;
        font-size: 28px;
        line-height: 1.25;
        color: var(--es-navy);
        margin: 5px 0 28px;
    }
    .db-stats {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 16px;
        margin-bottom: 20px;
    }
    .db-stat {
        background: var(--es-card);
        border: 1px solid var(--es-border);
        border-radius: 12px;
        padding: 22px 18px;
        text-align: center;
        box-shadow: 0 3px 14px rgba(15, 47, 122, .05);
        transition: all .2s ease;
    }
    .db-stat:hover {
        transform: translateY(-3px);
        box-shadow: 0 10px 24px rgba(15, 47, 122, .12);
    }
    .db-stat-icon {
        width: 44px;
        height: 44px;
        border-radius: 10px;
        background: #E8EFFC;
        color: var(--es-blue);
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 12px;
        font-size: 12px;
        font-weight: 800;
        letter-spacing: .3px;
    }
    .db-stat-num {
        font-weight: 800;
        font-size: 25px;
        line-height: 1.2;
        color: var(--es-navy);
        margin: 0 0 5px;
    }
    .db-stat-label {
        color: var(--es-muted);
        font-size: 13px;
    }
    .db-highlights {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 16px;
        margin-bottom: 25px;
    }
    .db-hl {
        background: var(--es-card);
        border: 1px solid var(--es-border);
        border-top: 3px solid var(--es-border);
        border-radius: 12px;
        padding: 22px 20px;
        text-align: center;
        box-shadow: 0 3px 14px rgba(15, 47, 122, .05);
    }
    .db-hl.cho {
        border-top-color: var(--es-red);
    }
    .db-hl.giao {
        border-top-color: var(--es-blue);
    }
    .db-hl.doanhthu {
        border-top-color: var(--es-success);
    }
    .db-hl-num {
        font-weight: 800;
        font-size: 25px;
        line-height: 1.3;
        margin: 0 0 5px;
        color: var(--es-text);
    }
    .db-hl.cho .db-hl-num {
        color: var(--es-red);
    }
    .db-hl.giao .db-hl-num {
        color: var(--es-blue);
    }
    .db-hl.doanhthu .db-hl-num {
        color: var(--es-success);
    }
    .db-hl-label {
        color: var(--es-muted);
        font-size: 13px;
        margin-bottom: 14px;
    }
    .db-hl-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 34px;
        padding: 0 15px;
        background: var(--es-red);
        color: #fff;
        border: 1px solid var(--es-red);
        border-radius: 6px;
        font-size: 12px;
        font-weight: 700;
        text-decoration: none;
        transition: all .2s ease;
    }
    .db-hl-btn:hover {
        background: #c41f25;
        border-color: #c41f25;
        color: #fff;
    }
    .db-grid {
        display: grid;
        grid-template-columns: 1.4fr 1fr;
        gap: 18px;
        align-items: start;
    }
    .db-panel {
        background: var(--es-card);
        border: 1px solid var(--es-border);
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 3px 14px rgba(15, 47, 122, .05);
    }
    .db-panel-head {
        padding: 17px 20px;
        border-bottom: 1px solid var(--es-border);
        font-weight: 800;
        color: #fff;
        font-size: 14px;
        background: linear-gradient(120deg, var(--es-navy), var(--es-blue));
    }
    .db-empty {
        color: var(--es-muted);
        padding: 25px 20px;
        margin: 0;
        font-size: 13px;
    }
    .db-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 13px;
    }
    .db-table thead th {
        text-align: left;
        font-weight: 800;
        color: var(--es-muted);
        padding: 11px 20px;
        font-size: 10px;
        text-transform: uppercase;
        letter-spacing: .7px;
        background: #F3F5F9;
        border-bottom: 1px solid var(--es-border);
        white-space: nowrap;
    }
    .db-table tbody td {
        padding: 13px 20px;
        border-bottom: 1px solid #EEF0F4;
        color: var(--es-text);
        vertical-align: middle;
    }
    .db-table tbody tr:last-child td {
        border-bottom: none;
    }
    .db-table tbody tr {
        transition: background .15s ease;
    }
    .db-table tbody tr:hover {
        background: #F7F9FD;
    }
    .db-table a {
        color: var(--es-blue);
        font-weight: 800;
        text-decoration: none;
    }
    .db-table a:hover {
        color: var(--es-blue-dark);
        text-decoration: underline;
    }
    .db-badge {
        display: inline-flex;
        align-items: center;
        background: #E8EFFC;
        color: var(--es-blue);
        font-weight: 700;
        font-size: 11px;
        padding: 5px 10px;
        border-radius: 20px;
        white-space: nowrap;
    }
    .db-list {
        list-style: none;
        margin: 0;
        padding: 0;
    }
    .db-list-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
        padding: 13px 20px;
        border-top: 1px solid #EEF0F4;
        font-size: 13px;
        color: var(--es-text);
    }
    .db-list-item:first-child {
        border-top: none;
    }
    .db-stock-badge {
        display: inline-flex;
        align-items: center;
        background: #FDECEC;
        color: var(--es-red);
        font-weight: 700;
        font-size: 11px;
        padding: 5px 11px;
        border-radius: 20px;
        white-space: nowrap;
    }
    @@media (max-width: 950px) {
        .db-stats {
            grid-template-columns: repeat(2, 1fr);
        }
        .db-highlights {
            grid-template-columns: repeat(2, 1fr);
        }
        .db-grid {
            grid-template-columns: 1fr;
        }
    }
    @@media (max-width: 576px) {
        .db-page {
            padding-top: 25px;
        }
        .db-title {
            font-size: 24px;
        }
        .db-stats {
            grid-template-columns: 1fr;
        }
        .db-highlights {
            grid-template-columns: 1fr;
        }
        .db-table {
            min-width: 700px;
        }
        .db-panel {
            overflow-x: auto;
        }
        .db-panel-head {
            min-width: 700px;
        }
    }
</style>
<div class="container db-page">
    <div class="db-eyebrow">Quản trị</div>
    <h1 class="db-title">Bảng điều khiển quản trị</h1>
    <div class="db-stats">
        <div class="db-stat">
            <div class="db-stat-icon">SP</div>
            <p class="db-stat-num">@Model.TongSanPham</p>
            <div class="db-stat-label">Sản phẩm</div>
        </div>
        <div class="db-stat">
            <div class="db-stat-icon">DM</div>
            <p class="db-stat-num">@Model.TongDanhMuc</p>
            <div class="db-stat-label">Danh mục</div>
        </div>
        <div class="db-stat">
            <div class="db-stat-icon">KH</div>
            <p class="db-stat-num">@Model.TongKhachHang</p>
            <div class="db-stat-label">Khách hàng</div>
        </div>
        <div class="db-stat">
            <div class="db-stat-icon">ĐH</div>
            <p class="db-stat-num">@Model.TongDonHang</p>
            <div class="db-stat-label">Tổng đơn hàng</div>
        </div>
    </div>
    <div class="db-highlights">
        <div class="db-hl cho">
            <p class="db-hl-num">@Model.DonChoXacNhan</p>
            <div class="db-hl-label">Đơn chờ xác nhận</div>
            <a asp-controller="DonHang" asp-action="Index" class="db-hl-btn">Xử lý ngay</a>
        </div>
        <div class="db-hl giao">
            <p class="db-hl-num">@Model.DonDangGiao</p>
            <div class="db-hl-label">Đơn đang giao</div>
        </div>
        <div class="db-hl doanhthu">
            <p class="db-hl-num">@Model.DoanhThu.ToString("N0") đ</p>
            <div class="db-hl-label">Doanh thu (đơn đã giao)</div>
        </div>
    </div>
    <div class="db-grid">
        <div class="db-panel">
            <div class="db-panel-head">Đơn hàng gần đây</div>
            @if (!Model.DonHangGanDay.Any())
            {
                <p class="db-empty">Chưa có đơn hàng nào.</p>
            }
            else
            {
                <table class="db-table">
                    <thead>
                        <tr>
                            <th>Mã ĐH</th>
                            <th>Khách hàng</th>
                            <th>Tổng tiền</th>
                            <th>Trạng thái</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var dh in Model.DonHangGanDay)
                        {
                            <tr>
                                <td>
                                    <a asp-controller="DonHang" asp-action="ChiTiet" asp-route-id="@dh.OrderID">
                                        #@dh.OrderID
                                    </a>
                                </td>
                                <td>@dh.User?.FullName</td>
                                <td>@dh.TotalAmount.ToString("N0") đ</td>
                                <td>
                                    @{
                                        string tenTrangThai = dh.OrderStatus switch
                                        {
                                            "Pending" => "Chờ xác nhận",
                                            "Processing" => "Đang xử lý",
                                            "Shipping" => "Đang giao",
                                            "Success" => "Đã giao",
                                            "Cancelled" => "Đã hủy",
                                            _ => dh.OrderStatus
                                        };
                                    }
                                    <span class="db-badge">@tenTrangThai</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
        <div class="db-panel">
            <div class="db-panel-head">Sản phẩm sắp hết hàng</div>
            @if (!Model.SanPhamSapHet.Any())
            {
                <p class="db-empty">Không có sản phẩm nào sắp hết.</p>
            }
            else
            {
                <ul class="db-list">
                    @foreach (var sp in Model.SanPhamSapHet)
                    {
                        <li class="db-list-item">
                            @sp.ProductName
                            <span class="db-stock-badge">Còn @sp.Stock</span>
                        </li>
                    }
                </ul>
            }
        </div>
    </div>
</div>