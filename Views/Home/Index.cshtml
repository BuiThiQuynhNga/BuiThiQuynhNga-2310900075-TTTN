@model IEnumerable<ElectronicsShop.Models.Product>
@{
    ViewData["Title"] = "Trang chủ";
    var danhMucList = ViewBag.DanhMucList as List<ElectronicsShop.Models.Category>;

    // Chuẩn hóa đường dẫn ảnh: chấp nhận tên trơn, "images/...", "/..." hoặc link http
    string LayAnh(string? url)
    {
        if (string.IsNullOrWhiteSpace(url)) return "/images/no-image.png";
        url = url.Trim();
        if (url.StartsWith("http") || url.StartsWith("/")) return url;
        if (url.StartsWith("images/")) return "/" + url;
        return "/images/" + url;
    }
}
<style>
    :root {
        --es-blue: #1E4FBF;
        --es-blue-dark: #0F2F7A;
        --es-navy: #0B1F4B;
        --es-red: #E0282E;
        --es-bg: #F3F5F9;
        --es-card: #FFFFFF;
        --es-text: #1F2937;
        --es-muted: #6B7280;
        --es-border: #E5E7EB;
    }
    body { background: var(--es-bg); color: var(--es-text); }

    /* Banner */
    .es-hero { display: grid; grid-template-columns: 2fr 1fr; gap: 16px; margin-bottom: 20px; }
    .es-hero-main {
        background: linear-gradient(120deg, var(--es-navy), var(--es-blue));
        color: #fff; border-radius: 14px; padding: 56px 44px; position: relative; overflow: hidden;
    }
    .es-hero-main::after {
        content: ""; position: absolute; width: 340px; height: 340px; right: -90px; bottom: -120px;
        border: 1px solid rgba(255,255,255,.14); border-radius: 50%;
    }
    .es-hero-tag {
        display: inline-block; background: var(--es-red); color: #fff; font-size: .72rem; font-weight: 700;
        letter-spacing: .05em; padding: 6px 12px; border-radius: 4px; margin-bottom: 16px;
    }
    .es-hero-main h1 { font-size: clamp(28px, 4vw, 46px); font-weight: 800; line-height: 1.15; margin-bottom: 14px; }
    .es-hero-main p { color: rgba(255,255,255,.8); max-width: 520px; margin-bottom: 24px; }
    .es-btn { display: inline-block; border-radius: 8px; padding: 11px 24px; font-weight: 700; text-decoration: none; font-size: .92rem; transition: all .15s ease; }
    .es-btn-red { background: var(--es-red); color: #fff; }
    .es-btn-red:hover { background: #c41f25; color: #fff; }
    .es-btn-line { border: 1px solid rgba(255,255,255,.6); color: #fff; margin-left: 8px; }
    .es-btn-line:hover { background: rgba(255,255,255,.14); color: #fff; }

    .es-hero-side { display: grid; grid-template-rows: 1fr 1fr; gap: 16px; }
    .es-side-card { border-radius: 14px; padding: 24px; color: #fff; display: flex; flex-direction: column; justify-content: center; text-decoration: none; }
    .es-side-card.a { background: linear-gradient(120deg, #123A93, #2B6CE0); }
    .es-side-card.b { background: linear-gradient(120deg, #0B1F4B, #24408F); }
    .es-side-card small { font-size: .7rem; font-weight: 700; letter-spacing: .06em; color: #FFD3D5; }
    .es-side-card h5 { font-weight: 800; margin: 6px 0; }
    .es-side-card span { font-size: .85rem; color: rgba(255,255,255,.85); }
    .es-side-card:hover { color: #fff; filter: brightness(1.08); }

    /* Cam kết */
    .es-perks { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; margin-bottom: 36px; }
    .es-perk { background: var(--es-card); border: 1px solid var(--es-border); border-radius: 12px; padding: 16px 18px; display: flex; align-items: center; gap: 14px; }
    .es-perk i { font-size: 1.7rem; color: var(--es-blue); }
    .es-perk strong { display: block; font-size: .9rem; }
    .es-perk small { color: var(--es-muted); font-size: .78rem; }

    /* Tiêu đề khu vực */
    .es-section-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 16px; }
    .es-section-head h2 { font-size: 1.25rem; font-weight: 800; margin: 0; padding-left: 12px; border-left: 4px solid var(--es-red); }
    .es-section-head a { font-size: .85rem; color: var(--es-blue); text-decoration: none; font-weight: 600; }

    /* Danh mục */
    .es-cats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; margin-bottom: 40px; }
    .es-cat { background: var(--es-card); border: 1px solid var(--es-border); border-radius: 12px; padding: 22px 12px; text-align: center; text-decoration: none; color: var(--es-text); transition: all .2s ease; }
    .es-cat:hover { border-color: var(--es-blue); transform: translateY(-3px); box-shadow: 0 8px 22px rgba(30,79,191,.12); color: var(--es-blue); }
    .es-cat i { font-size: 1.9rem; color: var(--es-blue); display: block; margin-bottom: 8px; }
    .es-cat h6 { font-weight: 700; font-size: .9rem; margin: 0; }

    /* Sản phẩm */
    .es-products { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
    .es-product { background: var(--es-card); border: 1px solid var(--es-border); border-radius: 12px; overflow: hidden; display: flex; flex-direction: column; transition: all .2s ease; }
    .es-product:hover { transform: translateY(-4px); box-shadow: 0 12px 28px rgba(15,47,122,.12); }
    .es-product-img { background: #fff; padding: 12px; border-bottom: 1px solid var(--es-border); }
    .es-product-img img { width: 100%; height: 240px; object-fit: contain; display: block; }
    .es-product-body { padding: 16px; flex: 1; }
    .es-product-cat { font-size: .68rem; font-weight: 700; color: var(--es-blue); text-transform: uppercase; letter-spacing: .05em; }
    .es-product-name { font-size: .98rem; font-weight: 700; line-height: 1.4; margin: 6px 0 10px; color: var(--es-text); }
    .es-product-price { color: var(--es-red); font-size: 1.2rem; font-weight: 800; margin: 0; }
    .es-product-foot { padding: 0 16px 16px; }
    .es-btn-detail { display: block; text-align: center; border: 1px solid var(--es-blue); color: var(--es-blue); border-radius: 8px; padding: 9px; font-weight: 700; font-size: .88rem; text-decoration: none; }
    .es-btn-detail:hover { background: var(--es-blue); color: #fff; }

    /* Đăng ký nhận tin */
    .es-news { background: linear-gradient(120deg, var(--es-navy), var(--es-blue)); color: #fff; border-radius: 14px; padding: 44px 24px; text-align: center; margin-top: 44px; }
    .es-news h3 { font-weight: 800; font-size: 1.4rem; margin-bottom: 6px; }
    .es-news p { color: rgba(255,255,255,.8); font-size: .9rem; margin-bottom: 20px; }
    .es-news form { display: flex; justify-content: center; gap: 8px; flex-wrap: wrap; }
    .es-news input { min-width: 280px; border: none; border-radius: 8px; padding: 12px 18px; }
    .es-news button { background: var(--es-red); color: #fff; border: none; border-radius: 8px; padding: 12px 26px; font-weight: 700; }
    .es-news button:hover { background: #c41f25; }

    @@media (max-width: 992px) {
        .es-hero { grid-template-columns: 1fr; }
        .es-hero-side { grid-template-columns: 1fr 1fr; grid-template-rows: auto; }
        .es-perks, .es-cats { grid-template-columns: repeat(2, 1fr); }
        .es-products { grid-template-columns: repeat(2, 1fr); }
    }
    @@media (max-width: 576px) {
        .es-hero-main { padding: 36px 22px; }
        .es-hero-side { grid-template-columns: 1fr; }
        .es-products { grid-template-columns: 1fr; }
        .es-news input { width: 100%; min-width: 0; }
    }
</style>

<div class="es-hero">
    <div class="es-hero-main">
        <span class="es-hero-tag">CHÍNH HÃNG 100% • GIAO HÀNG TOÀN QUỐC</span>
        <h1>CÔNG NGHỆ DẪN LỐI<br />NÂNG TẦM HIỆU SUẤT</h1>
        <p>Smartphone, laptop và phụ kiện công nghệ chính hãng với giá tốt, bảo hành 1 đổi 1 trong 30 ngày.</p>
        <a asp-controller="SanPham" asp-action="Index" class="es-btn es-btn-red">MUA NGAY</a>
        <a asp-controller="DanhMuc" asp-action="Index" class="es-btn es-btn-line">XEM DANH MỤC</a>
    </div>
    <div class="es-hero-side">
        <a asp-controller="SanPham" asp-action="Index" class="es-side-card a">
            <small>HOT DEAL</small>
            <h5>LAPTOP &amp; MÁY TÍNH</h5>
            <span>Xem cấu hình chi tiết →</span>
        </a>
        <a asp-controller="SanPham" asp-action="Index" class="es-side-card b">
            <small>GIÁ TỐT MỖI NGÀY</small>
            <h5>PHỤ KIỆN CÔNG NGHỆ</h5>
            <span>Nâng cấp ngay hôm nay →</span>
        </a>
    </div>
</div>

<div class="es-perks">
    <div class="es-perk"><i class="bi bi-truck"></i><div><strong>Giao hàng nhanh</strong><small>Nội thành 2h, toàn quốc 2-4 ngày</small></div></div>
    <div class="es-perk"><i class="bi bi-patch-check"></i><div><strong>Sản phẩm chính hãng</strong><small>Cam kết nguồn gốc rõ ràng</small></div></div>
    <div class="es-perk"><i class="bi bi-arrow-repeat"></i><div><strong>Bảo hành uy tín</strong><small>1 đổi 1 trong 30 ngày đầu</small></div></div>
    <div class="es-perk"><i class="bi bi-headset"></i><div><strong>Hỗ trợ kỹ thuật</strong><small>Tư vấn nhiệt tình 24/7</small></div></div>
</div>

@if (danhMucList != null && danhMucList.Any())
{
    <div class="es-section-head">
        <h2>Danh mục nổi bật</h2>
        <a asp-controller="DanhMuc" asp-action="Index">Xem tất cả danh mục →</a>
    </div>
    <div class="es-cats">
        @foreach (var dm in danhMucList)
        {
            <a asp-controller="SanPham" asp-action="Index" asp-route-danhMucId="@dm.CategoryID" class="es-cat">
                <i class="bi bi-laptop"></i>
                <h6>@dm.CategoryName</h6>
            </a>
        }
    </div>
}

<div class="es-section-head">
    <h2>Sản phẩm nổi bật</h2>
    <a asp-controller="SanPham" asp-action="Index">Xem tất cả →</a>
</div>
<div class="es-products">
    @foreach (var item in Model)
    {
        <div class="es-product">
            <div class="es-product-img">
                <img src="@LayAnh(item.ImageURL)"
                     onerror="this.onerror=null;this.src='/images/no-image.png'"
                     alt="@item.ProductName" />
            </div>
            <div class="es-product-body">
                <span class="es-product-cat">@item.Category?.CategoryName</span>
                <h5 class="es-product-name">@item.ProductName</h5>
                <p class="es-product-price">@item.Price.ToString("N0") VNĐ</p>
            </div>
            <div class="es-product-foot">
                <a asp-controller="SanPham"
                   asp-action="ChiTiet"
                   asp-route-id="@item.ProductID"
                   class="es-btn-detail">Chi Tiết</a>
            </div>
        </div>
    }
</div>

<div class="es-news">
    <h3>Đăng ký nhận ưu đãi mới nhất</h3>
    <p>Nhận mã giảm giá và thông tin sản phẩm công nghệ mới qua email</p>
    <form onsubmit="return false;">
        <input type="email" placeholder="Nhập email của bạn" />
        <button type="submit">Đăng ký</button>
    </form>
</div>