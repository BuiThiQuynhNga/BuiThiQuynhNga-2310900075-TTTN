<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ElectronicsShop</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        .navbar-custom {
            background-color: #2F5D62; /* --hd-primary */
        }
        .btn-custom-accent {
            background-color: #C97B4A; /* --hd-accent */
            color: #fff;
            border: none;
        }
        .btn-custom-accent:hover {
            background-color: #B36A3D;
            color: #fff;
        }
    </style>
</head>
<body>

    <nav class="navbar navbar-expand-lg navbar-dark navbar-custom shadow">

        <div class="container">

            <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">
                <i class="bi bi-laptop"></i>
                ElectronicsShop
            </a>

            <button class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#menu">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="menu">

                <!-- Menu trái -->
                <ul class="navbar-nav me-auto mb-2 mb-lg-0 gap-lg-2">

                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="Index">
                            <i class="bi bi-house"></i> Trang chủ
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" asp-controller="SanPham" asp-action="Index">
                            <i class="bi bi-box"></i> Sản phẩm
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" asp-controller="DanhMuc" asp-action="Index">
                            <i class="bi bi-grid"></i> Danh mục
                        </a>
                    </li>

                    @if (User.Identity != null && User.Identity.IsAuthenticated && User.IsInRole("Admin"))
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="DonHang" asp-action="Index">
                                <i class="bi bi-cart-check"></i> Đơn hàng
                            </a>
                        </li>
                    }

                    <li class="nav-item">
                        <a class="nav-link" asp-controller="MaGiamGia" asp-action="Index">
                            <i class="bi bi-tag"></i> Mã giảm giá
                        </a>
                    </li>

                </ul>

                <!-- Tìm kiếm -->
                <form class="d-flex me-3 mb-2 mb-lg-0"
                      asp-controller="SanPham"
                      asp-action="Index"
                      method="get">

                    <input class="form-control me-2"
                           type="search"
                           name="keyword"
                           placeholder="Tìm sản phẩm...">

                    <button class="btn btn-custom-accent">
                        <i class="bi bi-search"></i>
                    </button>

                </form>

                <!-- Giỏ hàng -->
                <a asp-controller="GioHang"
                   asp-action="Index"
                   class="btn btn-outline-light me-3 mb-2 mb-lg-0 position-relative">

                    <i class="bi bi-cart3"></i>
                    Giỏ hàng
                    @await Component.InvokeAsync("GioHangCount")

                </a>

                <!-- Tài khoản -->
                @if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    <div class="dropdown">

                        <button class="btn btn-success dropdown-toggle"
                                data-bs-toggle="dropdown" style="background-color: #22454A; border: none;">

                            <i class="bi bi-person-circle"></i>
                            @User.Identity.Name

                        </button>

                        <ul class="dropdown-menu dropdown-menu-end">

                            <li>
                                <a class="dropdown-item"
                                   asp-controller="TaiKhoan"
                                   asp-action="ThongTin">
                                    Hồ sơ
                                </a>
                            </li>

                            <li>
                                <a class="dropdown-item"
                                   asp-controller="DonHang"
                                   asp-action="LichSu">
                                    Đơn hàng của tôi
                                </a>
                            </li>

                            @if (User.IsInRole("Admin"))
                            {
                                <li><hr class="dropdown-divider"></li>

                                <li>
                                    <a class="dropdown-item"
                                       asp-controller="SanPham"
                                       asp-action="Index">
                                        Quản lý sản phẩm
                                    </a>
                                </li>

                                <li>
                                    <a class="dropdown-item"
                                       asp-controller="DanhMuc"
                                       asp-action="Index">
                                        Quản lý danh mục
                                    </a>
                                </li>

                                <li>
                                    <a class="dropdown-item"
                                       asp-controller="DonHang"
                                       asp-action="Index">
                                        Quản lý đơn hàng
                                    </a>
                                </li>

                                <li>
                                    <a class="dropdown-item"
                                       asp-controller="MaGiamGia"
                                       asp-action="Index">
                                        Quản lý mã giảm giá
                                    </a>
                                </li>
                            }

                            <li><hr class="dropdown-divider"></li>

                            <li>
                                <a class="dropdown-item text-danger"
                                   asp-controller="TaiKhoan"
                                   asp-action="DangXuat">
                                    Đăng xuất
                                </a>
                            </li>

                        </ul>

                    </div>
                }
                else
                {
                    <a asp-controller="TaiKhoan"
                       asp-action="DangNhap"
                       class="btn btn-outline-light me-2 mb-2 mb-lg-0">
                        Đăng nhập
                    </a>

                    <a asp-controller="TaiKhoan"
                       asp-action="DangKy"
                       class="btn btn-custom-accent">
                        Đăng ký
                    </a>
                }

            </div>

        </div>

    </nav>

    <div class="container mt-4">
        @RenderBody()
    </div>

    <footer class="text-white mt-5 py-4" style="background-color: #24262B;">

        <div class="container text-center">

            <h5>ElectronicsShop</h5>

            <p class="text-muted">
                Hệ thống bán lẻ thiết bị điện tử & công nghệ chính hãng
            </p>

            <small class="text-muted">
                &copy; 2026 ElectronicsShop - ASP.NET Core MVC
            </small>

        </div>

    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>