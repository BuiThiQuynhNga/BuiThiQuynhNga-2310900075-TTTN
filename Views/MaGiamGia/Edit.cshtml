@model ElectronicsShop.Models.DiscountCode

@{
    ViewData["Title"] = "Sửa mã giảm giá";
}
<style>
    .tv-page {
        --hd-primary: #2F5D62;
        --hd-primary-dark: #22454A;
        --hd-accent: #C97B4A;
        --hd-bg: #F7F7F5;
        --hd-card: #FFFFFF;
        --hd-text: #24262B;
        --hd-muted: #6B7076;
        --hd-border: #E7E5E1;
        max-width: 640px;
        margin: 0 auto;
        padding: 40px 16px 60px;
    }

    .tv-header .tv-eyebrow {
        font-size: 0.78rem;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--hd-muted);
        font-weight: 600;
    }

    .tv-header h1 {
        font-family: 'Poppins', sans-serif;
        font-weight: 800;
        font-size: 1.5rem;
        color: var(--hd-text);
        margin: 4px 0 24px;
    }

    .tv-preview {
        position: relative;
        display: flex;
        background: linear-gradient(160deg, var(--hd-primary-dark) 0%, #16292C 100%);
        border-radius: 14px;
        overflow: hidden;
        margin-bottom: 28px;
        color: #fff;
        box-shadow: 0 12px 28px rgba(34, 69, 74, 0.18);
    }

        .tv-preview.is-expired {
            filter: grayscale(0.5);
            opacity: 0.7;
        }

    .tv-preview-main {
        flex: 1;
        padding: 20px 18px;
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .tv-preview-eyebrow {
        font-size: 0.72rem;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: rgba(255, 255, 255, 0.55);
        font-weight: 600;
    }

    .tv-preview-percent {
        font-family: 'Poppins', sans-serif;
        font-weight: 800;
        font-size: 1.9rem;
        color: var(--hd-accent);
        line-height: 1;
    }

        .tv-preview-percent span {
            font-size: 1rem;
            font-weight: 600;
            color: rgba(255, 255, 255, 0.7);
            margin-left: 4px;
        }

    .tv-preview-name {
        font-weight: 700;
        font-size: 1.05rem;
        margin-top: 2px;
    }

    .tv-preview-used {
        font-size: 0.78rem;
        color: rgba(255, 255, 255, 0.6);
        margin-top: auto;
    }

    .tv-preview-divider {
        position: relative;
        width: 0;
        border-left: 2px dashed rgba(255, 255, 255, 0.25);
        margin: 14px 0;
    }

        .tv-preview-divider::before,
        .tv-preview-divider::after {
            content: "";
            position: absolute;
            left: -9px;
            width: 18px;
            height: 18px;
            border-radius: 50%;
            background: var(--hd-bg);
        }

        .tv-preview-divider::before {
            top: -14px;
        }

        .tv-preview-divider::after {
            bottom: -14px;
        }

    .tv-preview-stub {
        width: 84px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 12px 6px;
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        writing-mode: vertical-rl;
        transform: rotate(180deg);
        color: rgba(255, 255, 255, 0.85);
    }

    .tv-card {
        background: var(--hd-card);
        border: 1px solid var(--hd-border);
        border-radius: 16px;
        padding: 28px 24px;
    }

    .tv-field {
        position: relative;
        margin-bottom: 18px;
    }

        .tv-field label {
            display: block;
            font-size: 0.85rem;
            font-weight: 600;
            color: var(--hd-text);
            margin-bottom: 6px;
        }

    .tv-hint {
        font-size: 0.78rem;
        color: var(--hd-muted);
        margin-top: 4px;
    }

    .tv-field input[type="text"],
    .tv-field input[type="number"],
    .tv-field input[type="datetime-local"] {
        width: 100%;
        border: 1.5px solid var(--hd-border);
        border-radius: 10px;
        padding: 11px 14px;
        font-size: 0.95rem;
        color: var(--hd-text);
        background: #fff;
        transition: border-color .15s ease, box-shadow .15s ease;
    }

    .tv-field input:focus {
        outline: none;
        border-color: var(--hd-primary);
        box-shadow: 0 0 0 3px rgba(47, 93, 98, 0.12);
    }

    .tv-field input[readonly] {
        background: #F1F0EE;
        color: var(--hd-muted);
        cursor: not-allowed;
    }

    .tv-check {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 12px 14px;
        border: 1.5px solid var(--hd-border);
        border-radius: 10px;
        margin-bottom: 20px;
    }

        .tv-check input {
            width: 18px;
            height: 18px;
            accent-color: var(--hd-primary);
        }

        .tv-check label {
            margin: 0;
            font-size: 0.9rem;
            font-weight: 600;
            color: var(--hd-text);
        }

    .tv-submit {
        width: 100%;
        border: none;
        border-radius: 10px;
        padding: 14px;
        font-weight: 700;
        font-size: 1rem;
        color: #fff;
        background: var(--hd-primary);
        cursor: pointer;
        transition: background .15s ease, transform .15s ease;
    }

        .tv-submit:hover {
            background: var(--hd-primary-dark);
            transform: translateY(-1px);
        }

    .tv-cancel {
        display: block;
        text-align: center;
        margin-top: 10px;
        padding: 12px;
        border-radius: 10px;
        border: 1.5px solid var(--hd-border);
        color: var(--hd-muted);
        font-weight: 600;
        text-decoration: none;
        transition: border-color .15s ease, color .15s ease;
    }

        .tv-cancel:hover {
            border-color: var(--hd-primary);
            color: var(--hd-primary);
        }

    .text-danger {
        font-size: 0.8rem;
    }
</style>
<div class="tv-page">
    <div class="tv-header">
        <div class="tv-eyebrow">Quản lý ưu đãi</div>
        <h1>Sửa mã giảm giá</h1>
    </div>

    <div class="tv-preview @(Model.IsActive ? "" : "is-expired")">
        <div class="tv-preview-main">
            <div class="tv-preview-eyebrow">ElectronicsShop</div>
            <div class="tv-preview-percent">@Model.DiscountPercent<span>%</span></div>
            <div class="tv-preview-name">@Model.CodeName</div>
            <div class="tv-preview-used">Đã dùng: @Model.UsedQuantity / @Model.TotalQuantity</div>
        </div>
        <div class="tv-preview-divider"></div>
        <div class="tv-preview-stub">@(Model.IsActive ? "Hoạt động" : "Tạm khóa")</div>
    </div>

    <div class="tv-card">
        <form asp-action="Sua" asp-route-id="@Model.DiscountCodeID" method="post">
            <input type="hidden" asp-for="DiscountCodeID" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="tv-field">
                <label>Mã voucher</label>
                <input asp-for="CodeName" type="text" readonly />
            </div>

            <div class="tv-field">
                <label>Phần trăm giảm (%)</label>
                <input asp-for="DiscountPercent" type="number" step="1" min="0" max="100" />
                <span asp-validation-for="DiscountPercent" class="text-danger"></span>
            </div>

            <div class="tv-field">
                <label>Giá trị giảm tối đa</label>
                <input asp-for="MaxDiscountAmount" type="number" step="0.01" min="0" />
            </div>

            <div class="tv-field">
                <label>Số lượng mã (đã dùng: @Model.UsedQuantity)</label>
                <input asp-for="TotalQuantity" type="number" min="@Model.UsedQuantity" />
                <span asp-validation-for="TotalQuantity" class="text-danger"></span>
            </div>

            <div class="tv-field">
                <label>Ngày kết thúc</label>
                <input asp-for="ExpiryDate" type="datetime-local" />
            </div>

            <div class="tv-check">
                <input asp-for="IsActive" type="checkbox" />
                <label>Đang hoạt động</label>
            </div>

            <button type="submit" class="tv-submit">Lưu thay đổi</button>
            <a asp-action="Index" class="tv-cancel">Hủy</a>
        </form>
    </div>
</div>