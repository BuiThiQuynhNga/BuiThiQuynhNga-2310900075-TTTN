@model ElectronicsShop.Models.DiscountCode

@{
    ViewData["Title"] = "Tạo mã giảm giá";
}

<style>
    .tv-page {
        --es-blue: #1E4FBF;
        --es-blue-dark: #0F2F7A;
        --es-navy: #0B1F4B;
        --es-red: #E0282E;
        --es-green: #16A34A;
        --es-bg: #F3F5F9;
        --es-text: #1F2937;
        --es-muted: #6B7280;
        --es-border: #E5E7EB;
        padding: 10px 0 50px;
    }
    .tv-crumb { font-size: .8rem; color: var(--es-muted); margin-bottom: 14px; }
    .tv-crumb a { color: var(--es-muted); text-decoration: none; }
    .tv-crumb a:hover { color: var(--es-blue); }
    .tv-crumb b { color: var(--es-blue); }
    .tv-title { font-weight: 800; font-size: 1.7rem; color: var(--es-navy); margin: 0 0 4px; }
    .tv-subtitle { color: var(--es-muted); font-size: .92rem; margin: 0 0 22px; }

    .tv-layout { display: grid; grid-template-columns: 1fr 380px; gap: 22px; align-items: start; }

    /* ===== THẺ FORM ===== */
    .tv-card {
        background: #fff; border: 1px solid var(--es-border); border-radius: 14px; overflow: hidden;
        box-shadow: 0 3px 14px rgba(15,47,122,.06);
    }
    .tv-card-head {
        display: flex; align-items: center; gap: 12px; padding: 16px 24px;
        background: linear-gradient(120deg, var(--es-navy), var(--es-blue)); color: #fff;
    }
    .tv-card-head i { font-size: 1.2rem; }
    .tv-card-head h5 { margin: 0; font-weight: 800; font-size: 1rem; }
    .tv-card-head small { display: block; color: rgba(255,255,255,.75); font-size: .78rem; font-weight: 400; }
    .tv-card-body { padding: 26px 24px; }

    .tv-summary {
        color: #B3261E; font-size: .88rem; margin-bottom: 16px;
        background: #FDECEC; border: 1px solid #F6C7C7; border-radius: 10px; padding: 10px 16px;
    }
    .tv-summary.validation-summary-valid { display: none; }
    .tv-summary ul { margin: 0; padding-left: 18px; }

    .tv-section {
        font-size: .7rem; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; color: var(--es-muted);
        margin: 4px 0 14px; padding-bottom: 8px; border-bottom: 1px solid var(--es-border);
    }
    .tv-section:not(:first-of-type) { margin-top: 26px; }

    .tv-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18px 16px; }
    .tv-group.full { grid-column: 1 / -1; }
    .tv-label { display: block; font-size: .82rem; font-weight: 700; color: var(--es-text); margin-bottom: 6px; }
    .tv-label span { color: var(--es-red); }

    .tv-field {
        display: flex; align-items: center; gap: 10px;
        background: #F3F5F9; border: 1.5px solid transparent; border-radius: 10px;
        padding: 0 14px; transition: all .15s ease;
    }
    .tv-field:focus-within { background: #fff; border-color: var(--es-blue); box-shadow: 0 0 0 3px rgba(30,79,191,.12); }
    .tv-field > i { color: var(--es-muted); }
    .tv-input {
        flex: 1; border: none; background: transparent; outline: none;
        padding: 13px 0; font-size: .95rem; color: var(--es-text); font-family: inherit; min-width: 0; width: 100%;
    }
    .tv-input.code { font-family: Consolas, monospace; font-weight: 800; letter-spacing: .04em; text-transform: uppercase; color: var(--es-blue); }
    .tv-suffix { color: var(--es-muted); font-weight: 700; font-size: .9rem; }
    .tv-hint { font-size: .76rem; color: var(--es-muted); margin-top: 5px; display: block; }
    .tv-page .text-danger { font-size: .78rem; display: block; margin-top: 4px; color: #B3261E !important; }

    /* ===== CÔNG TẮC KÍCH HOẠT ===== */
    .tv-switch {
        display: flex; align-items: center; justify-content: space-between; gap: 14px;
        border: 1.5px solid var(--es-border); border-radius: 12px; padding: 14px 16px; cursor: pointer;
        transition: all .15s ease;
    }
    .tv-switch:hover { border-color: #C9D6F3; }
    .tv-switch:has(input:checked) { border-color: var(--es-blue); background: #F1F5FF; }
    .tv-switch-info { display: flex; align-items: center; gap: 12px; }
    .tv-switch-icon {
        width: 40px; height: 40px; border-radius: 10px; background: #E8EFFC; color: var(--es-blue);
        display: flex; align-items: center; justify-content: center; font-size: 1.15rem; flex-shrink: 0;
    }
    .tv-switch-info strong { display: block; color: var(--es-navy); font-size: .92rem; }
    .tv-switch-info small { color: var(--es-muted); font-size: .78rem; }
    .tv-switch input[type="checkbox"] {
        appearance: none; -webkit-appearance: none; flex-shrink: 0;
        width: 46px; height: 26px; border-radius: 26px; background: #CBD2DC; position: relative;
        cursor: pointer; transition: background .2s ease; margin: 0;
    }
    .tv-switch input[type="checkbox"]::after {
        content: ""; position: absolute; top: 3px; left: 3px; width: 20px; height: 20px; border-radius: 50%;
        background: #fff; box-shadow: 0 1px 4px rgba(0,0,0,.25); transition: transform .2s ease;
    }
    .tv-switch input[type="checkbox"]:checked { background: var(--es-blue); }
    .tv-switch input[type="checkbox"]:checked::after { transform: translateX(20px); }
    .tv-switch input[type="checkbox"]:focus-visible { outline: 3px solid rgba(30,79,191,.3); outline-offset: 2px; }

    .tv-actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 26px; padding-top: 20px; border-top: 1px solid var(--es-border); }
    .tv-btn {
        border: none; border-radius: 10px; padding: 13px 26px; font-size: .92rem; font-weight: 800; cursor: pointer;
        text-decoration: none; display: inline-flex; align-items: center; justify-content: center; gap: 8px;
        transition: all .15s ease;
    }
    .tv-btn.save { background: var(--es-blue); color: #fff; flex: 1; min-width: 180px; }
    .tv-btn.save:hover { background: var(--es-blue-dark); transform: translateY(-1px); }
    .tv-btn.cancel { background: #fff; border: 1.5px solid var(--es-border); color: var(--es-text); }
    .tv-btn.cancel:hover { border-color: var(--es-blue); color: var(--es-blue); }

    /* ===== XEM TRƯỚC ===== */
    .tv-side { position: sticky; top: 90px; }
    .tv-side-title { font-size: .7rem; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; color: var(--es-muted); margin: 0 0 10px; display: flex; align-items: center; gap: 6px; }
    .tv-side-title i { color: var(--es-blue); }

    .tv-item { filter: drop-shadow(0 6px 16px rgba(15,47,122,.16)); margin-bottom: 16px; transition: opacity .2s ease; }
    .tv-item.off { opacity: .6; }
    .tv-ticket {
        display: flex; background: #fff; border-radius: 14px; overflow: hidden; min-height: 150px;
        -webkit-mask-image:
            radial-gradient(circle at calc(100% - 96px) 0, transparent 9px, #000 9.5px),
            radial-gradient(circle at calc(100% - 96px) 100%, transparent 9px, #000 9.5px);
        -webkit-mask-composite: source-in;
        mask-image:
            radial-gradient(circle at calc(100% - 96px) 0, transparent 9px, #000 9.5px),
            radial-gradient(circle at calc(100% - 96px) 100%, transparent 9px, #000 9.5px);
        mask-composite: intersect;
    }
    .tv-pbox {
        width: 92px; flex-shrink: 0; display: flex; flex-direction: column; align-items: center; justify-content: center;
        background: linear-gradient(160deg, var(--es-navy), var(--es-blue)); color: #fff; text-align: center; padding: 12px 6px;
        transition: background .2s ease;
    }
    .tv-item.off .tv-pbox { background: linear-gradient(160deg, #6B7280, #9CA3AF); }
    .tv-pbox i { font-size: 1.2rem; opacity: .85; margin-bottom: 4px; }
    .tv-ppercent { font-weight: 800; font-size: 1.9rem; line-height: 1; }
    .tv-ppercent span { font-size: 1rem; font-weight: 700; }
    .tv-plabel { font-size: .68rem; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; opacity: .85; margin-top: 4px; }
    .tv-pmain { flex: 1; padding: 16px 18px; display: flex; flex-direction: column; gap: 6px; min-width: 0; }
    .tv-pname { font-weight: 800; color: var(--es-navy); font-size: 1.05rem; word-break: break-all; }
    .tv-pmeta { font-size: .8rem; color: var(--es-muted); margin: 0; display: flex; align-items: center; gap: 6px; }
    .tv-pmeta i { color: var(--es-blue); }
    .tv-pdiv { width: 0; border-left: 2px dashed var(--es-border); margin: 14px 0; }
    .tv-pstub { width: 96px; flex-shrink: 0; display: flex; align-items: center; justify-content: center; padding: 10px 8px; }
    .tv-pstatus {
        display: inline-flex; flex-direction: column; align-items: center; gap: 4px; text-align: center;
        font-size: .74rem; font-weight: 800; padding: 10px; border-radius: 12px; line-height: 1.3;
        color: var(--es-green); background: #E8F6EC;
    }
    .tv-pstatus i { font-size: 1.3rem; }
    .tv-item.off .tv-pstatus { color: var(--es-muted); background: #EEF0F4; }

    .tv-tips {
        background: #E8EFFC; border-radius: 12px; padding: 14px 16px; font-size: .8rem; color: var(--es-muted); line-height: 1.6;
    }
    .tv-tips b { color: var(--es-navy); display: block; margin-bottom: 4px; }
    .tv-tips i { color: var(--es-blue); }

    @@media (max-width: 1000px) {
        .tv-layout { grid-template-columns: 1fr; }
        .tv-side { position: static; order: -1; }
    }
    @@media (max-width: 576px) {
        .tv-grid { grid-template-columns: 1fr; }
        .tv-card-body { padding: 20px 16px; }
    }
</style>

<div class="container tv-page">

    <div class="tv-crumb">
        <a asp-controller="Home" asp-action="Index"><i class="bi bi-house-door"></i> Trang chủ</a>
        &nbsp;/&nbsp;
        <a asp-action="QuanLy">Mã giảm giá</a>
        &nbsp;/&nbsp; <b>Tạo mã mới</b>
    </div>

    <h1 class="tv-title">Tạo mã giảm giá mới</h1>
    <p class="tv-subtitle">Thiết lập mức giảm, thời hạn và số lượng phát hành cho mã khuyến mại.</p>

    <div class="tv-layout">

        <!-- ===== FORM ===== -->
        <div class="tv-card">
            <div class="tv-card-head">
                <i class="bi bi-ticket-perforated"></i>
                <div>
                    <h5>Thông tin mã giảm giá</h5>
                    <small>Điền đầy đủ các trường bên dưới</small>
                </div>
            </div>
            <div class="tv-card-body">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="All" class="tv-summary"></div>

                    <div class="tv-section">Nội dung ưu đãi</div>
                    <div class="tv-grid">
                        <div class="tv-group full">
                            <label class="tv-label" for="CodeName">Mã voucher <span>*</span></label>
                            <div class="tv-field">
                                <i class="bi bi-upc-scan"></i>
                                <input asp-for="CodeName" type="text" class="tv-input code" placeholder="VD: SALE50" autocomplete="off" />
                            </div>
                            <span asp-validation-for="CodeName" class="text-danger"></span>
                        </div>

                        <div class="tv-group">
                            <label class="tv-label" for="DiscountPercent">Phần trăm giảm <span>*</span></label>
                            <div class="tv-field">
                                <i class="bi bi-percent"></i>
                                <input asp-for="DiscountPercent" type="number" step="1" min="0" max="100" class="tv-input" />
                                <span class="tv-suffix">%</span>
                            </div>
                            <span asp-validation-for="DiscountPercent" class="text-danger"></span>
                        </div>

                        <div class="tv-group">
                            <label class="tv-label" for="MaxDiscountAmount">Giá trị giảm tối đa</label>
                            <div class="tv-field">
                                <i class="bi bi-cash-coin"></i>
                                <input asp-for="MaxDiscountAmount" type="number" step="0.01" min="0" class="tv-input" />
                                <span class="tv-suffix">đ</span>
                            </div>
                            <span class="tv-hint">Để trống nếu không giới hạn</span>
                            <span asp-validation-for="MaxDiscountAmount" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="tv-section">Thời hạn &amp; số lượng</div>
                    <div class="tv-grid">
                        <div class="tv-group">
                            <label class="tv-label" for="ExpiryDate">Ngày kết thúc <span>*</span></label>
                            <div class="tv-field">
                                <i class="bi bi-calendar-event"></i>
                                <input asp-for="ExpiryDate" type="datetime-local" class="tv-input" />
                            </div>
                            <span asp-validation-for="ExpiryDate" class="text-danger"></span>
                        </div>

                        <div class="tv-group">
                            <label class="tv-label" for="TotalQuantity">Số lượng mã phát hành <span>*</span></label>
                            <div class="tv-field">
                                <i class="bi bi-stack"></i>
                                <input asp-for="TotalQuantity" type="number" min="1" class="tv-input" />
                                <span class="tv-suffix">lượt</span>
                            </div>
                            <span asp-validation-for="TotalQuantity" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="tv-section">Trạng thái</div>
                    <label class="tv-switch" for="IsActive">
                        <div class="tv-switch-info">
                            <div class="tv-switch-icon"><i class="bi bi-lightning-charge"></i></div>
                            <div>
                                <strong>Kích hoạt ngay</strong>
                                <small>Khách hàng có thể dùng mã ngay sau khi tạo</small>
                            </div>
                        </div>
                        <input asp-for="IsActive" type="checkbox" />
                    </label>

                    <div class="tv-actions">
                        <button type="submit" class="tv-btn save"><i class="bi bi-check2-circle"></i> Tạo mã</button>
                        <a asp-action="QuanLy" class="tv-btn cancel"><i class="bi bi-x-lg"></i> Hủy</a>
                    </div>
                </form>
            </div>
        </div>

        <!-- ===== XEM TRƯỚC ===== -->
        <aside class="tv-side">
            <h6 class="tv-side-title"><i class="bi bi-eye"></i> Xem trước</h6>

            <div class="tv-item" id="pvItem">
                <div class="tv-ticket">
                    <div class="tv-pbox">
                        <i class="bi bi-tag-fill"></i>
                        <div class="tv-ppercent"><span id="pvPercent">0</span><span>%</span></div>
                        <div class="tv-plabel">Giảm giá</div>
                    </div>
                    <div class="tv-pmain">
                        <div class="tv-pname" id="pvName">MÃ VOUCHER</div>
                        <p class="tv-pmeta" id="pvMaxRow"><i class="bi bi-cash-coin"></i> <span id="pvMax">Không giới hạn</span></p>
                        <p class="tv-pmeta"><i class="bi bi-calendar-event"></i> Hết hạn: <span id="pvExpiry">--/--/----</span></p>
                        <p class="tv-pmeta"><i class="bi bi-stack"></i> Phát hành: <span id="pvQty">0</span> lượt</p>
                    </div>
                    <div class="tv-pdiv"></div>
                    <div class="tv-pstub">
                        <span class="tv-pstatus" id="pvStatus"><i class="bi bi-check-circle-fill"></i> <span id="pvStatusText">Kích hoạt</span></span>
                    </div>
                </div>
            </div>

            <div class="tv-tips">
                <b><i class="bi bi-lightbulb"></i> Gợi ý</b>
                Đặt tên mã ngắn, dễ nhớ (ví dụ SALE50) và nên đặt giá trị giảm tối đa để kiểm soát chi phí khuyến mại.
            </div>
        </aside>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        // Vé xem trước cập nhật theo dữ liệu đang nhập (chỉ hiển thị trên trang, không gửi gì lên server)
        (function () {
            var elName = document.getElementById('CodeName');
            var elPercent = document.getElementById('DiscountPercent');
            var elMax = document.getElementById('MaxDiscountAmount');
            var elExpiry = document.getElementById('ExpiryDate');
            var elQty = document.getElementById('TotalQuantity');
            var elActive = document.getElementById('IsActive');

            var pvItem = document.getElementById('pvItem');
            var pvName = document.getElementById('pvName');
            var pvPercent = document.getElementById('pvPercent');
            var pvMax = document.getElementById('pvMax');
            var pvExpiry = document.getElementById('pvExpiry');
            var pvQty = document.getElementById('pvQty');
            var pvStatus = document.getElementById('pvStatus');
            var pvStatusText = document.getElementById('pvStatusText');

            function fmt(n) { return Number(n).toLocaleString('vi-VN'); }

            function capNhat() {
                var ten = (elName.value || '').trim();
                pvName.textContent = ten ? ten.toUpperCase() : 'MÃ VOUCHER';

                var pt = parseInt(elPercent.value);
                pvPercent.textContent = isNaN(pt) ? 0 : pt;

                var max = parseFloat(elMax.value);
                pvMax.textContent = (isNaN(max) || elMax.value === '') ? 'Không giới hạn' : 'Tối đa ' + fmt(max) + ' đ';

                if (elExpiry.value) {
                    var d = new Date(elExpiry.value);
                    if (!isNaN(d)) {
                        pvExpiry.textContent =
                            String(d.getDate()).padStart(2, '0') + '/' +
                            String(d.getMonth() + 1).padStart(2, '0') + '/' + d.getFullYear();
                    }
                } else {
                    pvExpiry.textContent = '--/--/----';
                }

                var sl = parseInt(elQty.value);
                pvQty.textContent = isNaN(sl) ? 0 : fmt(sl);

                var on = elActive.checked;
                pvItem.classList.toggle('off', !on);
                pvStatus.querySelector('i').className = on ? 'bi bi-check-circle-fill' : 'bi bi-pause-circle-fill';
                pvStatusText.textContent = on ? 'Kích hoạt' : 'Tạm ngưng';
            }

            [elName, elPercent, elMax, elExpiry, elQty].forEach(function (el) {
                if (el) el.addEventListener('input', capNhat);
            });
            if (elActive) elActive.addEventListener('change', capNhat);
            capNhat();
        })();
    </script>
}