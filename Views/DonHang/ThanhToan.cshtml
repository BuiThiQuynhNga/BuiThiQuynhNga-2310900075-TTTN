@model ElectronicsShop.Models.Order

@{
    ViewData["Title"] = "Thanh toán";
    bool coSanPhamThieuHang = Model.OrderDetails.Any(od => od.Quantity > od.Product.Stock);
}
<style>
    .tt-page {
        --hd-primary: #2F5D62;
        --hd-primary-dark: #22454A;
        --hd-accent: #C97B4A;
        --hd-bg: #F7F7F5;
        --hd-card: #FFFFFF;
        --hd-text: #24262B;
        --hd-muted: #6B7076;
        --hd-border: #E7E5E1;
        padding: 40px 0 60px;
    }

    .tt-eyebrow {
        font-size: 0.78rem;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--hd-muted);
        font-weight: 600;
    }

    .tt-title {
        font-family: 'Poppins', sans-serif;
        font-weight: 800;
        font-size: 1.5rem;
        color: var(--hd-text);
        margin: 4px 0 24px;
    }

    .tt-layout {
        display: grid;
        grid-template-columns: 1.5fr 1fr;
        gap: 24px;
        align-items: start;
    }

    .tt-card {
        background: var(--hd-card);
        border: 1px solid var(--hd-border);
        border-radius: 16px;
        padding: 24px;
        margin-bottom: 24px;
    }

    .tt-card-title {
        font-size: 1.1rem;
        font-weight: 700;
        color: var(--hd-text);
        margin-bottom: 16px;
    }

    .tt-group {
        margin-bottom: 18px;
    }

    .tt-label {
        display: block;
        font-size: 0.85rem;
        font-weight: 700;
        color: var(--hd-text);
        margin-bottom: 6px;
    }

    .tt-input {
        width: 100%;
        border: 1px solid var(--hd-border);
        border-radius: 8px;
        padding: 10px 12px;
        font-size: 0.92rem;
        color: var(--hd-text);
        background: #fff;
        transition: border-color .15s ease;
    }

        .tt-input:focus {
            outline: none;
            border-color: var(--hd-primary);
            box-shadow: 0 0 0 3px rgba(47, 93, 98, 0.12);
        }

    .tt-payment-method {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        border: 1.5px solid var(--hd-primary);
        background: #F2F7F6;
        padding: 16px;
        border-radius: 10px;
    }

        .tt-payment-method input[type="radio"] {
            margin-top: 4px;
            accent-color: var(--hd-primary);
        }

    .tt-payment-info strong {
        display: block;
        color: var(--hd-primary-dark);
        font-weight: 700;
        margin-bottom: 4px;
    }

    .tt-payment-info p {
        margin: 0;
        font-size: 0.85rem;
        color: var(--hd-muted);
    }

    .tt-list {
        list-style: none;
        padding: 0;
        margin: 0 0 16px;
        border-top: 1px solid var(--hd-border);
    }

    .tt-list-item {
        padding: 14px 0;
        border-bottom: 1px solid var(--hd-border);
    }

    .tt-item-row {
        display: flex;
        justify-content: space-between;
        font-size: 0.9rem;
        color: var(--hd-text);
        font-weight: 500;
    }

    .tt-item-err {
        color: #C0524A;
        font-size: 0.8rem;
        margin-top: 4px;
        font-weight: 600;
    }

    .tt-alert {
        background: #F7E9E7;
        color: #9A3E33;
        border-radius: 10px;
        padding: 12px 16px;
        font-size: 0.85rem;
        font-weight: 500;
        margin-bottom: 16px;
    }

    .tt-summary-row {
        display: flex;
        justify-content: space-between;
        font-size: 0.92rem;
        color: var(--hd-text);
        margin-bottom: 10px;
    }

    .tt-summary-free {
        color: var(--hd-primary-dark);
        font-weight: 700;
    }

    .tt-total-row {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        margin: 16px 0;
        padding-top: 16px;
        border-top: 1px dashed var(--hd-border);
    }

        .tt-total-row span {
            font-weight: 700;
            color: var(--hd-text);
        }

        .tt-total-row strong {
            font-family: 'Poppins', sans-serif;
            font-size: 1.4rem;
            font-weight: 800;
            color: var(--hd-accent);
        }

    .tt-btn {
        display: block;
        width: 100%;
        border: none;
        border-radius: 10px;
        padding: 14px;
        font-weight: 700;
        font-size: 1rem;
        color: #fff;
        background: var(--hd-primary);
        cursor: pointer;
        transition: background .15s ease, transform .15s ease;
    }

        .tt-btn:hover:not(:disabled) {
            background: var(--hd-primary-dark);
            transform: translateY(-1px);
        }

        .tt-btn:disabled {
            background: var(--hd-muted);
            cursor: not-allowed;
            opacity: 0.7;
        }

    @@media (max-width: 860px) {
        .tt-layout {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="container tt-page">
    <div class="tt-eyebrow">Đơn hàng</div>
    <h1 class="tt-title">Thanh toán đơn hàng</h1>

    <div asp-validation-summary="All" class="tt-alert" style="@(ViewData.ModelState.IsValid ? "display:none" : "")"></div>

    <form asp-action="ThanhToan" method="post">
        <div class="tt-layout">
            <!-- Cột trái: Thông tin giao hàng & Thanh toán -->
            <div>
                <div class="tt-card">
                    <h3 class="tt-card-title">Thông tin nhận hàng</h3>
                    <div class="tt-group">
                        <label class="tt-label">Địa chỉ giao hàng</label>
                        <input name="ShippingAddress" class="tt-input" required placeholder="Nhập địa chỉ chi tiết" />
                    </div>
                    <div class="tt-group mb-0">
                        <label class="tt-label">Số điện thoại nhận hàng</label>
                        <input name="ReceiverPhone" class="tt-input" required placeholder="Nhập số điện thoại liên hệ" />
                    </div>
                </div>

                <div class="tt-card">
                    <h3 class="tt-card-title">Hình thức thanh toán</h3>
                    <div class="tt-payment-method">
                        <input type="radio" checked disabled />
                        <div class="tt-payment-info">
                            <strong>💵 Thanh toán khi nhận hàng (COD)</strong>
                            <p>Bạn thanh toán tiền mặt trực tiếp cho nhân viên giao hàng khi nhận sản phẩm.</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Cột phải: Tổng kết đơn hàng -->
            <div>
                <div class="tt-card">
                    <h3 class="tt-card-title">Tóm tắt đơn hàng</h3>
                    
                    <ul class="tt-list">
                        @foreach (var od in Model.OrderDetails)
                        {
                            bool khongDu = od.Quantity > od.Product.Stock;
                            <li class="tt-list-item">
                                <div class="tt-item-row">
                                    <span>@od.Product.ProductName (x@(od.Quantity))</span>
                                    <span>@((od.UnitPrice * od.Quantity).ToString("N0")) đ</span>
                                </div>
                                @if (khongDu)
                                {
                                    <div class="tt-item-err">⚠️ Chỉ còn @od.Product.Stock sản phẩm trong kho</div>
                                }
                            </li>
                        }
                    </ul>

                    @if (coSanPhamThieuHang)
                    {
                        <div class="tt-alert">
                            Một số sản phẩm trong đơn không đủ hàng trong kho. Vui lòng quay lại giỏ hàng để cập nhật số lượng trước khi đặt hàng.
                        </div>
                    }

                    <div class="tt-summary-row">
                        <span>Phí vận chuyển:</span>
                        @if (Model.ShippingFee > 0)
                        {
                            <span>@Model.ShippingFee.ToString("N0") đ</span>
                        }
                        else
                        {
                            <span class="tt-summary-free">Miễn phí</span>
                        }
                    </div>

                    <div class="tt-total-row">
                        <span>Tổng tiền</span>
                        <strong>@Model.TotalAmount.ToString("N0") đ</strong>
                    </div>

                    <button type="submit" class="tt-btn" disabled="@(coSanPhamThieuHang ? "disabled" : null)">
                        Xác nhận đặt hàng
                    </button>
                </div>
            </div>
        </div>
    </form>
</div>