@model IEnumerable<ElectronicsShop.Models.Order>

@{
    ViewData["Title"] = "Quản lý đơn hàng";
}

<style>
    .dh-page {
        --es-blue: #1E4FBF;
        --es-blue-dark: #0F2F7A;
        --es-navy: #0B1F4B;
        --es-red: #E0282E;
        --es-green: #16A34A;
        --es-text: #1F2937;
        --es-muted: #6B7280;
        --es-border: #E5E7EB;
        padding: 40px 0 60px;
    }

    .dh-header {
        display: flex; justify-content: space-between; align-items: flex-end;
        gap: 12px; flex-wrap: wrap; margin-bottom: 24px;
    }
    .dh-eyebrow {
        font-size: .78rem; letter-spacing: .14em; text-transform: uppercase;
        color: var(--es-blue); font-weight: 700;
    }
    .dh-header h1 { font-weight: 800; font-size: 1.7rem; color: var(--es-navy); margin: 4px 0 0; }

    .dh-count {
        font-size: .85rem; font-weight: 700; color: var(--es-blue);
        background: #E8EFFC; border-radius: 20px; padding: 7px 16px;
    }

    .dh-alert {
        display: flex; align-items: center; gap: 10px;
        background: #E8F6EC; color: #166534; border: 1px solid #BBE5C8;
        border-radius: 10px; padding: 12px 16px; font-size: .9rem; font-weight: 600; margin-bottom: 20px;
    }

    .dh-empty {
        background: #fff; border: 1px dashed var(--es-border); border-radius: 16px;
        padding: 48px 24px; text-align: center; color: var(--es-muted);
    }

    .dh-table-wrap {
        background: #fff; border: 1px solid var(--es-border); border-radius: 14px; overflow: hidden;
        box-shadow: 0 3px 14px rgba(15,47,122,.06);
    }
    .dh-table { width: 100%; border-collapse: collapse; font-size: .92rem; }
    .dh-table thead { background: linear-gradient(120deg, var(--es-navy), var(--es-blue)); }
    .dh-table thead th {
        text-align: left; font-weight: 700; color: #fff; padding: 14px 16px; font-size: .74rem;
        text-transform: uppercase; letter-spacing: .06em; white-space: nowrap;
    }
    .dh-table tbody td {
        padding: 14px 16px; border-bottom: 1px solid var(--es-border);
        color: var(--es-text); vertical-align: middle;
    }
    .dh-table tbody tr:last-child td { border-bottom: none; }
    .dh-table tbody tr { transition: background .15s ease; }
    .dh-table tbody tr:hover { background: #F7F9FE; }

    .dh-id { font-weight: 800; color: var(--es-blue); }
    .dh-total { font-weight: 800; color: var(--es-navy); white-space: nowrap; }

    /* ---- Badge phương thức thanh toán ---- */
    .dh-pay {
        display: inline-flex; align-items: center; gap: 6px; padding: 5px 12px; border-radius: 8px;
        font-size: .78rem; font-weight: 800; white-space: nowrap;
    }
    .dh-pay.ck   { background: #E8EFFC; color: var(--es-blue); }
    .dh-pay.cod  { background: #FFF1E6; color: #C2410C; }
    .dh-pay.khac { background: #EEF0F4; color: var(--es-muted); }

    /* ---- Badge trạng thái ---- */
    .dh-badge {
        display: inline-flex; align-items: center; gap: 6px; padding: 5px 12px; border-radius: 20px;
        font-size: .78rem; font-weight: 800; white-space: nowrap;
    }
    .dh-badge::before { content: ""; width: 6px; height: 6px; border-radius: 50%; background: currentColor; }
    .dh-badge.cho  { background: #FFF4DB; color: #A16207; }
    .dh-badge.giao { background: #E8EFFC; color: var(--es-blue); }
    .dh-badge.hoan { background: #E8F6EC; color: var(--es-green); }
    .dh-badge.huy  { background: #EEF0F4; color: var(--es-muted); }
    .dh-badge.khac { background: #EFE8F5; color: #6C4A93; }

    /* ---- Nút hành động ---- */
    .dh-actions { display: flex; flex-wrap: wrap; gap: 6px; }
    .dh-actions form { margin: 0; }
    .dh-btn {
        border: none; border-radius: 8px; padding: 8px 14px; font-size: .82rem; font-weight: 700;
        cursor: pointer; text-decoration: none; display: inline-flex; align-items: center; gap: 6px;
        white-space: nowrap; transition: all .15s ease;
    }
    .dh-btn.view { background: #fff; border: 1.5px solid var(--es-blue); color: var(--es-blue); }
    .dh-btn.view:hover { background: var(--es-blue); color: #fff; }
    .dh-btn.confirm { background: var(--es-blue); color: #fff; }
    .dh-btn.confirm:hover { background: var(--es-blue-dark); }
    .dh-btn.cancel { background: #fff; border: 1.5px solid #F0B4B6; color: var(--es-red); }
    .dh-btn.cancel:hover { background: var(--es-red); border-color: var(--es-red); color: #fff; }

    @@media (max-width: 1000px) {
        .dh-table-wrap { overflow-x: auto; }
        .dh-table { min-width: 900px; }
    }
</style>

<div class="container dh-page">
    <div class="dh-header">
        <div>
            <div class="dh-eyebrow">Vận hành</div>
            <h1>Quản lý đơn hàng</h1>
        </div>
        <span class="dh-count">@Model.Count() đơn hàng</span>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="dh-alert"><i class="bi bi-check-circle-fill"></i> @TempData["SuccessMessage"]</div>
    }

    @if (!Model.Any())
    {
        <div class="dh-empty">Chưa có đơn hàng nào.</div>
    }
    else
    {
        <div class="dh-table-wrap">
            <table class="dh-table">
                <thead>
                    <tr>
                        <th>Mã ĐH</th>
                        <th>Khách hàng</th>
                        <th>Ngày đặt</th>
                        <th>Tổng tiền</th>
                        <th>Thanh toán</th>
                        <th>Trạng thái</th>
                        <th style="width: 320px">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var dh in Model)
                    {
                        <tr>
                            <td class="dh-id">#@dh.OrderID</td>
                            <td>@dh.User?.FullName</td>
                            <td>@dh.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                            <td class="dh-total">@dh.TotalAmount.ToString("N0") đ</td>
                            <td>
                                @{
                                    // Đổi PaymentMethod thành tên thuộc tính thật trong model Order của bạn
                                    string pt = (dh.PaymentMethod ?? "").Trim().ToLower();
                                    string lopPt, tenPt, iconPt;

                                    if (pt.Contains("bank") || pt.Contains("chuyen") || pt.Contains("chuyển")
                                        || pt.Contains("transfer") || pt.Contains("qr"))
                                    {
                                        lopPt = "ck"; tenPt = "Chuyển khoản"; iconPt = "bi-bank";
                                    }
                                    else if (pt.Contains("cod") || pt.Contains("cash") || pt.Contains("tien")
                                        || pt.Contains("tiền") || pt.Contains("mặt"))
                                    {
                                        lopPt = "cod"; tenPt = "Tiền mặt (COD)"; iconPt = "bi-cash-coin";
                                    }
                                    else
                                    {
                                        lopPt = "khac";
                                        tenPt = string.IsNullOrEmpty(pt) ? "Chưa rõ" : dh.PaymentMethod;
                                        iconPt = "bi-wallet2";
                                    }
                                }
                                <span class="dh-pay @lopPt"><i class="bi @iconPt"></i> @tenPt</span>
                            </td>
                            <td>
                                @{
                                    string lopBadge = dh.OrderStatus switch
                                    {
                                        "Pending" => "cho",
                                        "Shipping" => "giao",
                                        "Success" => "hoan",
                                        "Cancelled" => "huy",
                                        _ => "khac"
                                    };
                                    string tenTrangThai = dh.OrderStatus switch
                                    {
                                        "Pending" => "Chờ xác nhận",
                                        "Shipping" => "Đang giao",
                                        "Success" => "Đã giao",
                                        "Cancelled" => "Đã hủy",
                                        _ => dh.OrderStatus
                                    };
                                }
                                <span class="dh-badge @lopBadge">@tenTrangThai</span>
                            </td>
                            <td>
                                <div class="dh-actions">
                                    <a asp-action="ChiTiet" asp-route-id="@dh.OrderID" class="dh-btn view"><i class="bi bi-eye"></i> Xem</a>

                                    @if (dh.OrderStatus == "Pending")
                                    {
                                        <form asp-action="CapNhatTrangThai" method="post" class="d-inline">
                                            <input type="hidden" name="id" value="@dh.OrderID" />
                                            <input type="hidden" name="trangThai" value="Shipping" />
                                            <button type="submit" class="dh-btn confirm"><i class="bi bi-check2-circle"></i> Xác nhận</button>
                                        </form>
                                        <form asp-action="CapNhatTrangThai" method="post" class="d-inline"
                                              onsubmit="return confirm('Bạn chắc chắn muốn hủy đơn hàng #@dh.OrderID?');">
                                            <input type="hidden" name="id" value="@dh.OrderID" />
                                            <input type="hidden" name="trangThai" value="Cancelled" />
                                            <button type="submit" class="dh-btn cancel"><i class="bi bi-x-circle"></i> Hủy đơn</button>
                                        </form>
                                    }
                                    else if (dh.OrderStatus == "Shipping")
                                    {
                                        <form asp-action="CapNhatTrangThai" method="post" class="d-inline">
                                            <input type="hidden" name="id" value="@dh.OrderID" />
                                            <input type="hidden" name="trangThai" value="Success" />
                                            <button type="submit" class="dh-btn confirm"><i class="bi bi-truck"></i> Hoàn tất giao hàng</button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>