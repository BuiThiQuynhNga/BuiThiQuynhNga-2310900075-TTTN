@model IEnumerable<ElectronicsShop.Models.Order>

@{
    ViewData["Title"] = "Quản lý đơn hàng";
}
<style>
    .dh-page {
        --hd-primary: #2F5D62;
        --hd-primary-dark: #22454A;
        --hd-accent: #C97B4A;
        --hd-bg: #F7F7F5;
        --hd-card: #FFFFFF;
        --hd-text: #24262B;
        --hd-muted: #6B7076;
        --hd-border: #E7E5E1;
        padding: 40px 0 60px;
    }

    .dh-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        margin-bottom: 24px;
        flex-wrap: wrap;
        gap: 12px;
    }

        .dh-header .dh-eyebrow {
            font-size: 0.78rem;
            letter-spacing: 0.14em;
            text-transform: uppercase;
            color: var(--hd-muted);
            font-weight: 600;
        }

        .dh-header h1 {
            font-family: 'Poppins', sans-serif;
            font-weight: 800;
            font-size: 1.5rem;
            color: var(--hd-text);
            margin: 4px 0 0;
        }

    .dh-count {
        font-size: 0.85rem;
        color: var(--hd-muted);
        background: var(--hd-card);
        border: 1px solid var(--hd-border);
        border-radius: 20px;
        padding: 6px 14px;
    }

    .dh-alert {
        background: #E7F0EF;
        color: var(--hd-primary-dark);
        border-radius: 10px;
        padding: 12px 16px;
        font-size: 0.9rem;
        font-weight: 500;
        margin-bottom: 20px;
    }

    .dh-empty {
        background: var(--hd-card);
        border: 1px dashed var(--hd-border);
        border-radius: 16px;
        padding: 48px 24px;
        text-align: center;
        color: var(--hd-muted);
    }

    .dh-table-wrap {
        background: var(--hd-card);
        border: 1px solid var(--hd-border);
        border-radius: 16px;
        overflow: hidden;
    }

    .dh-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.92rem;
    }

        .dh-table thead {
            background: #F1F0EE;
        }

            .dh-table thead th {
                text-align: left;
                font-weight: 700;
                color: var(--hd-text);
                padding: 14px 16px;
                font-size: 0.82rem;
                text-transform: uppercase;
                letter-spacing: 0.04em;
                border-bottom: 1px solid var(--hd-border);
            }

        .dh-table tbody td {
            padding: 14px 16px;
            border-bottom: 1px solid var(--hd-border);
            color: var(--hd-text);
            vertical-align: middle;
        }

        .dh-table tbody tr:last-child td {
            border-bottom: none;
        }

        .dh-table tbody tr {
            transition: background .15s ease;
        }

            .dh-table tbody tr:hover {
                background: #FAFAF8;
            }

    .dh-id {
        font-weight: 700;
        color: var(--hd-primary);
    }

    .dh-total {
        font-weight: 700;
    }

    /* ---- Badge trạng thái ---- */
    .dh-badge {
        display: inline-block;
        padding: 5px 12px;
        border-radius: 20px;
        font-size: 0.78rem;
        font-weight: 700;
        white-space: nowrap;
    }

        .dh-badge.cho {
            background: #FBEFDD;
            color: #9A6A1E;
        }

        .dh-badge.giao {
            background: #E4EEF6;
            color: #2A5F8A;
        }

        .dh-badge.hoan {
            background: #E7F0EF;
            color: var(--hd-primary-dark);
        }

        .dh-badge.huy {
            background: #F1F0EE;
            color: var(--hd-muted);
        }

        .dh-badge.khac {
            background: #EFE8F5;
            color: #6C4A93;
        }

    /* ---- Nút hành động ---- */
    .dh-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
    }

    .dh-btn {
        border: none;
        border-radius: 8px;
        padding: 7px 12px;
        font-size: 0.82rem;
        font-weight: 600;
        cursor: pointer;
        text-decoration: none;
        display: inline-block;
        transition: background .15s ease, color .15s ease, border-color .15s ease;
    }

        .dh-btn.view {
            background: transparent;
            border: 1.5px solid var(--hd-primary);
            color: var(--hd-primary);
        }

            .dh-btn.view:hover {
                background: var(--hd-primary);
                color: #fff;
            }

        .dh-btn.confirm {
            background: var(--hd-primary);
            color: #fff;
        }

            .dh-btn.confirm:hover {
                background: var(--hd-primary-dark);
            }

        .dh-btn.cancel {
            background: transparent;
            border: 1.5px solid #C0524A;
            color: #C0524A;
        }

            .dh-btn.cancel:hover {
                background: #C0524A;
                color: #fff;
            }

    @@media (max-width: 900px) {
        .dh-table-wrap {
            overflow-x: auto;
        }

        .dh-table {
            min-width: 760px;
        }
    }
</style>
<div class="container dh-page">
    <div class="dh-header">
        <div>
            <div class="dh-eyebrow">Vận hành</div>
            <h1>Quản lý đơn hàng</h1>
        </div>
        <span class="dh-count">@Model.Count() đơn hàng</span>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="dh-alert">@TempData["SuccessMessage"]</div>
    }

    @if (!Model.Any())
    {
        <div class="dh-empty">Chưa có đơn hàng nào.</div>
    }
    else
    {
        <div class="dh-table-wrap">
            <table class="dh-table">
                <thead>
                    <tr>
                        <th>Mã ĐH</th>
                        <th>Khách hàng</th>
                        <th>Ngày đặt</th>
                        <th>Tổng tiền</th>
                        <th>Trạng thái</th>
                        <th style="width: 320px">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var dh in Model)
                    {
                        <tr>
                            <td class="dh-id">#@dh.OrderID</td>
                            <td>@dh.User?.FullName</td>
                            <td>@dh.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                            <td class="dh-total">@dh.TotalAmount.ToString("N0") đ</td>
                            <td>
                                @{
                                    string lopBadge = dh.OrderStatus switch
                                    {
                                        "Pending" => "cho",
                                        "Shipping" => "giao",
                                        "Success" => "hoan",
                                        "Cancelled" => "huy",
                                        _ => "khac"
                                    };
                                    string tenTrangThai = dh.OrderStatus switch
                                    {
                                        "Pending" => "Chờ xác nhận",
                                        "Shipping" => "Đang giao",
                                        "Success" => "Đã giao",
                                        "Cancelled" => "Đã hủy",
                                        _ => dh.OrderStatus
                                    };
                                }
                                <span class="dh-badge @lopBadge">@tenTrangThai</span>
                            </td>
                            <td>
                                <div class="dh-actions">
                                    <a asp-action="ChiTiet" asp-route-id="@dh.OrderID" class="dh-btn view">Xem</a>

                                    @if (dh.OrderStatus == "Pending")
                                    {
                                        <form asp-action="CapNhatTrangThai" method="post" class="d-inline">
                                            <input type="hidden" name="id" value="@dh.OrderID" />
                                            <input type="hidden" name="trangThai" value="Shipping" />
                                            <button type="submit" class="dh-btn confirm">Xác nhận</button>
                                        </form>
                                        <form asp-action="CapNhatTrangThai" method="post" class="d-inline"
                                              onsubmit="return confirm('Bạn chắc chắn muốn hủy đơn hàng #@dh.OrderID?');">
                                            <input type="hidden" name="id" value="@dh.OrderID" />
                                            <input type="hidden" name="trangThai" value="Cancelled" />
                                            <button type="submit" class="dh-btn cancel">Hủy đơn</button>
                                        </form>
                                    }
                                    else if (dh.OrderStatus == "Shipping")
                                    {
                                        <form asp-action="CapNhatTrangThai" method="post" class="d-inline">
                                            <input type="hidden" name="id" value="@dh.OrderID" />
                                            <input type="hidden" name="trangThai" value="Success" />
                                            <button type="submit" class="dh-btn confirm">Hoàn tất giao hàng</button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>