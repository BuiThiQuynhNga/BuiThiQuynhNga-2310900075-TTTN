@model ElectronicsShop.Models.Order

@{
    ViewData["Title"] = "Chi tiết đơn hàng";
}
<div class="container py-4">
    <h3 class="fw-bold mb-4">Chi Tiết Đơn Hàng #@Model.OrderID</h3>

    <p><strong>Khách hàng:</strong> @Model.User?.FullName</p>
    <p><strong>Địa chỉ giao hàng:</strong> @Model.ShippingAddress</p>
    <p><strong>SĐT nhận hàng:</strong> @Model.ReceiverPhone</p>
    <p><strong>Trạng thái:</strong> <span class="badge bg-info text-dark">@Model.OrderStatus</span></p>

    <table class="table mt-3">
        <thead>
            <tr>
                <th>Sản phẩm</th>
                <th>Đơn giá</th>
                <th>Số lượng</th>
                <th>Thành tiền</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var ct in Model.OrderDetails)
            {
                <tr>
                    <td>@ct.Product.ProductName</td>
                    <td>@ct.UnitPrice.ToString("N0") đ</td>
                    <td>@ct.Quantity</td>
                    <td>@((ct.UnitPrice * ct.Quantity).ToString("N0")) đ</td>
                </tr>
            }
        </tbody>
    </table>

    <h5 class="text-end text-danger fw-bold">Tổng tiền: @Model.TotalAmount.ToString("N0") đ</h5>

    <a asp-action="LichSu" class="btn btn-outline-secondary mt-3">← Quay lại</a>
</div>