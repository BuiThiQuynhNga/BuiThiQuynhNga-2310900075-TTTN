@model IEnumerable<ElectronicsShop.Models.Order>

@{
    ViewData["Title"] = "Đơn hàng của tôi";
}

<style>
    .dhc-page {
        --es-blue: #1E4FBF;
        --es-blue-dark: #0F2F7A;
        --es-navy: #0B1F4B;
        --es-red: #E0282E;
        --es-green: #16A34A;
        --es-text: #1F2937;
        --es-muted: #6B7280;
        --es-border: #E5E7EB;
        padding: 40px 0 60px;
    }

    .dhc-eyebrow {
        font-size: .78rem; letter-spacing: .14em; text-transform: uppercase;
        color: var(--es-blue); font-weight: 700;
    }
    .dhc-title { font-weight: 800; font-size: 1.7rem; color: var(--es-navy); margin: 4px 0 24px; }

    .dhc-empty {
        background: #fff; border: 1px dashed var(--es-border); border-radius: 16px;
        padding: 48px 24px; text-align: center; color: var(--es-muted);
    }
    .dhc-empty a { color: var(--es-blue); font-weight: 700; text-decoration: none; }
    .dhc-empty a:hover { text-decoration: underline; }

    .dhc-card {
        background: #fff; border: 1px solid var(--es-border); border-radius: 14px;
        padding: 20px 24px; margin-bottom: 16px;
        box-shadow: 0 3px 14px rgba(15,47,122,.06);
        transition: transform .2s ease, box-shadow .2s ease;
    }
    .dhc-card:hover { transform: translateY(-2px); box-shadow: 0 10px 22px rgba(15,47,122,.12); }

    .dhc-top {
        display: flex; justify-content: space-between; align-items: center;
        flex-wrap: wrap; gap: 8px; margin-bottom: 10px;
    }
    .dhc-id { font-weight: 800; color: var(--es-blue); font-size: 1.05rem; margin: 0; }

    .dhc-badge {
        display: inline-flex; align-items: center; gap: 6px; padding: 5px 12px; border-radius: 20px;
        font-size: .78rem; font-weight: 800; white-space: nowrap;
    }
    .dhc-badge::before { content: ""; width: 6px; height: 6px; border-radius: 50%; background: currentColor; }
    .dhc-badge.cho  { background: #FFF4DB; color: #A16207; }
    .dhc-badge.giao { background: #E8EFFC; color: var(--es-blue); }
    .dhc-badge.hoan { background: #E8F6EC; color: var(--es-green); }
    .dhc-badge.huy  { background: #EEF0F4; color: var(--es-muted); }
    .dhc-badge.khac { background: #EFE8F5; color: #6C4A93; }

    .dhc-date {
        color: var(--es-muted); font-size: .85rem; margin: 0 0 10px;
        display: flex; align-items: center; gap: 6px;
    }
    .dhc-date i { color: var(--es-blue); }

    .dhc-items {
        border-top: 1px dashed var(--es-border); border-bottom: 1px dashed var(--es-border);
        padding: 10px 0; margin-bottom: 12px;
    }
    .dhc-item { display: block; color: var(--es-text); font-size: .9rem; padding: 3px 0; }

    .dhc-total { font-weight: 800; color: var(--es-red); font-size: 1.05rem; margin: 0; text-align: right; }
</style>

<div class="container dhc-page">
    <div class="dhc-eyebrow">Tài khoản</div>
    <h1 class="dhc-title">Đơn hàng của tôi</h1>

    @if (!Model.Any())
    {
        <div class="dhc-empty">
            Bạn chưa có đơn hàng nào. <a asp-controller="SanPham" asp-action="Index">Mua sắm ngay</a>
        </div>
    }
    else
    {
        @foreach (var dh in Model)
        {
            string lopBadge = dh.OrderStatus switch
            {
                "Pending" => "cho",
                "Shipping" => "giao",
                "Success" => "hoan",
                "Cancelled" => "huy",
                _ => "khac"
            };

            string tenTrangThai = dh.OrderStatus switch
            {
                "Pending" => "Chờ xác nhận",
                "Shipping" => "Đang giao",
                "Success" => "Đã giao",
                "Cancelled" => "Đã hủy",
                _ => dh.OrderStatus
            };

            <div class="dhc-card">
                <div class="dhc-top">
                    <h6 class="dhc-id">Đơn hàng #@dh.OrderID</h6>
                    <span class="dhc-badge @lopBadge">@tenTrangThai</span>
                </div>
                <p class="dhc-date"><i class="bi bi-calendar-event"></i> Ngày đặt: @dh.OrderDate.ToString("dd/MM/yyyy HH:mm")</p>
                <div class="dhc-items">
                    @foreach (var ct in dh.OrderDetails)
                    {
                        <span class="dhc-item">@ct.Product.ProductName (x@(ct.Quantity))</span>
                    }
                </div>
                <p class="dhc-total">Tổng: @dh.TotalAmount.ToString("N0") đ</p>
            </div>
        }
    }
</div>