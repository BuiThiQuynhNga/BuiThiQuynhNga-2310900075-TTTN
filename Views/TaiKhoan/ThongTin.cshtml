@model ElectronicsShop.Models.User
@{
    ViewData["Title"] = "Thông tin tài khoản";
}
<style>
    .tk-page {
        --hd-primary: #2F5D62;
        --hd-primary-dark: #22454A;
        --hd-accent: #C97B4A;
        --hd-bg: #F7F7F5;
        --hd-card: #FFFFFF;
        --hd-text: #24262B;
        --hd-muted: #6B7076;
        --hd-border: #E7E5E1;
        padding: 48px 0 60px;
    }

    .tk-wrap {
        max-width: 560px;
        margin: 0 auto;
    }

    .tk-card {
        background: var(--hd-card);
        border: 1px solid var(--hd-border);
        border-radius: 16px;
        padding: 36px;
    }

    .tk-top {
        text-align: center;
        margin-bottom: 28px;
    }

    .tk-avatar {
        width: 64px;
        height: 64px;
        border-radius: 50%;
        background: #E7F0EF;
        color: var(--hd-primary-dark);
        display: flex;
        align-items: center;
        justify-content: center;
        font-family: 'Poppins', sans-serif;
        font-weight: 800;
        font-size: 1.4rem;
        margin: 0 auto 12px;
    }

    .tk-name {
        font-family: 'Poppins', sans-serif;
        font-weight: 800;
        font-size: 1.3rem;
        color: var(--hd-text);
        margin: 0 0 8px;
    }

    .tk-role {
        display: inline-block;
        background: #E4EEF6;
        color: #2A5F8A;
        font-weight: 700;
        font-size: 0.78rem;
        padding: 5px 14px;
        border-radius: 20px;
    }

    .tk-alert {
        background: #E7F0EF;
        color: var(--hd-primary-dark);
        border-radius: 10px;
        padding: 12px 16px;
        font-size: 0.9rem;
        font-weight: 500;
        margin-bottom: 20px;
    }

    .tk-summary {
        color: #C0524A;
        font-size: 0.85rem;
        margin-bottom: 16px;
    }

    .tk-group {
        margin-bottom: 18px;
    }

    .tk-label {
        display: block;
        font-size: 0.85rem;
        font-weight: 700;
        color: var(--hd-text);
        margin-bottom: 6px;
    }

    .tk-input,
    .tk-textarea {
        width: 100%;
        border: 1px solid var(--hd-border);
        border-radius: 8px;
        padding: 10px 12px;
        font-size: 0.92rem;
        color: var(--hd-text);
        background: #fff;
        transition: border-color .15s ease;
        font-family: inherit;
    }

        .tk-input:focus,
        .tk-textarea:focus {
            outline: none;
            border-color: var(--hd-primary);
        }

        .tk-input:disabled {
            background: var(--hd-bg);
            color: var(--hd-muted);
        }

    .tk-textarea {
        resize: vertical;
    }

    .tk-hint {
        font-size: 0.78rem;
        color: var(--hd-muted);
        margin-top: 4px;
        display: block;
    }

    .tk-err {
        color: #C0524A;
        font-size: 0.8rem;
        margin-top: 4px;
        display: block;
    }

    .tk-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-top: 24px;
    }

    .tk-btn {
        border: none;
        border-radius: 8px;
        padding: 10px 22px;
        font-size: 0.9rem;
        font-weight: 600;
        cursor: pointer;
        text-decoration: none;
        display: inline-block;
        transition: background .15s ease, color .15s ease, border-color .15s ease;
    }

        .tk-btn.save {
            background: var(--hd-primary);
            color: #fff;
        }

            .tk-btn.save:hover {
                background: var(--hd-primary-dark);
            }

        .tk-btn.pass {
            background: transparent;
            border: 1.5px solid var(--hd-border);
            color: var(--hd-text);
        }

            .tk-btn.pass:hover {
                border-color: var(--hd-primary);
                color: var(--hd-primary);
            }

    .tk-back {
        display: inline-block;
        margin-top: 20px;
        color: var(--hd-muted);
        font-size: 0.85rem;
        text-decoration: none;
    }

        .tk-back:hover {
            color: var(--hd-primary);
        }
</style>
<div class="container tk-page">
    <div class="tk-wrap">
        <div class="tk-card">
            <div class="tk-top">
                <div class="tk-avatar">@(string.IsNullOrEmpty(Model.FullName) ? "?" : Model.FullName.Trim().Substring(0, 1).ToUpper())</div>
                <h3 class="tk-name">@Model.FullName</h3>
                <span class="tk-role">@Model.Role</span>
            </div>

            @if (TempData["ThongBao"] != null)
            {
                <div class="tk-alert">@TempData["ThongBao"]</div>
            }

            <form asp-action="CapNhatThongTin" method="post">
                <input type="hidden" asp-for="UserID" />
                <div class="tk-group">
                    <label class="tk-label">Email</label>
                    <input value="@Model.Email" class="tk-input" disabled />
                </div>
                <div class="tk-group">
                    <label asp-for="FullName" class="tk-label">Họ tên</label>
                    <input asp-for="FullName" class="tk-input" maxlength="100" />
                </div>
                <div class="tk-group">
                    <label asp-for="Phone" class="tk-label">Số điện thoại</label>
                    <input asp-for="Phone" class="tk-input" maxlength="15" />
                </div>
                <div class="tk-group">
                    <label asp-for="Address" class="tk-label">Địa chỉ</label>
                    <textarea asp-for="Address" class="tk-textarea" rows="2" maxlength="255"></textarea>
                </div>
                <div class="tk-actions">
                    <button type="submit" class="tk-btn save">Cập nhật thông tin</button>
                    <a asp-controller="TaiKhoan" asp-action="DoiMatKhau" class="tk-btn pass">Đổi mật khẩu</a>
                </div>
            </form>
            <a asp-controller="Home" asp-action="Index" class="tk-back">← Quay lại</a>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}