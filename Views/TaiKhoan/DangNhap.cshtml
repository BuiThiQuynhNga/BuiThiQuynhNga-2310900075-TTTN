@model ElectronicsShop.Models.User

@{
    ViewData["Title"] = "Đăng nhập";
}
<style>
    .dn-page {
        --hd-primary: #2F5D62;
        --hd-primary-dark: #22454A;
        --hd-accent: #C97B4A;
        --hd-bg: #F7F7F5;
        --hd-card: #FFFFFF;
        --hd-text: #24262B;
        --hd-muted: #6B7076;
        --hd-border: #E7E5E1;
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: calc(100vh - 120px);
        padding: 48px 16px;
        background: var(--hd-bg);
    }

    .dn-card {
        display: grid;
        grid-template-columns: 0.85fr 1.15fr;
        max-width: 860px;
        width: 100%;
        background: var(--hd-card);
        border-radius: 20px;
        overflow: hidden;
        border: 1px solid var(--hd-border);
        box-shadow: 0 20px 50px rgba(34, 69, 74, 0.12);
    }

    .dn-brand {
        background: linear-gradient(160deg, var(--hd-primary-dark) 0%, #16292C 100%);
        padding: 40px 32px;
        color: #fff;
        display: flex;
        flex-direction: column;
        gap: 28px;
    }

    .dn-brand-eyebrow {
        font-size: 0.75rem;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: rgba(255, 255, 255, 0.55);
        font-weight: 600;
    }

    .dn-brand h3 {
        font-family: 'Poppins', sans-serif;
        font-weight: 800;
        font-size: 1.5rem;
        line-height: 1.3;
        margin: 8px 0 0;
    }

    .dn-brand p {
        color: rgba(255, 255, 255, 0.72);
        font-size: 0.92rem;
        max-width: 26ch;
        margin: 12px 0 0;
    }

    .dn-shades {
        margin-top: auto;
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .dn-shade {
        display: flex;
        align-items: center;
        gap: 12px;
        opacity: 0;
        transform: translateX(-8px);
        animation: dn-fade .5s ease forwards;
    }

        .dn-shade:nth-child(1) {
            animation-delay: .05s;
        }

        .dn-shade:nth-child(2) {
            animation-delay: .12s;
        }

        .dn-shade:nth-child(3) {
            animation-delay: .19s;
        }

        .dn-shade:nth-child(4) {
            animation-delay: .26s;
        }

    @@keyframes dn-fade {
        to {
            opacity: 1;
            transform: translateX(0);
        }
    }

    .dn-swatch {
        width: 28px;
        height: 28px;
        border-radius: 8px;
        flex-shrink: 0;
        box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.15);
    }

    .dn-shade span {
        font-size: 0.82rem;
        color: rgba(255, 255, 255, 0.8);
    }

    @@media (prefers-reduced-motion: reduce) {
        .dn-shade {
            animation: none;
            opacity: 1;
            transform: none;
        }
    }

    .dn-form-panel {
        padding: 44px 40px;
    }

        .dn-form-panel h1 {
            font-family: 'Poppins', sans-serif;
            font-weight: 800;
            font-size: 1.5rem;
            color: var(--hd-text);
            margin: 0 0 4px;
        }

    .dn-sub {
        color: var(--hd-muted);
        font-size: 0.92rem;
        margin: 0 0 24px;
    }

    .dn-alert {
        background: #E7F0EF;
        color: var(--hd-primary-dark);
        border-radius: 10px;
        padding: 12px 14px;
        font-size: 0.88rem;
        font-weight: 500;
        margin-bottom: 20px;
    }

    .dn-field {
        position: relative;
        margin-bottom: 18px;
    }

        .dn-field input {
            width: 100%;
            border: 1.5px solid var(--hd-border);
            border-radius: 10px;
            padding: 18px 14px 8px;
            font-size: 0.95rem;
            color: var(--hd-text);
            background: #fff;
            transition: border-color .15s ease, box-shadow .15s ease;
        }

            .dn-field input:focus {
                outline: none;
                border-color: var(--hd-primary);
                box-shadow: 0 0 0 3px rgba(47, 93, 98, 0.12);
            }

        .dn-field label {
            position: absolute;
            left: 14px;
            top: 14px;
            font-size: 0.95rem;
            color: var(--hd-muted);
            pointer-events: none;
            transition: all .15s ease;
        }

        .dn-field input:focus + label,
        .dn-field input:not(:placeholder-shown) + label {
            top: 5px;
            font-size: 0.7rem;
            color: var(--hd-primary);
            font-weight: 600;
        }

    .dn-submit {
        margin-top: 6px;
        width: 100%;
        border: none;
        border-radius: 10px;
        padding: 14px;
        font-weight: 700;
        font-size: 1rem;
        color: #fff;
        background: var(--hd-primary);
        cursor: pointer;
        transition: background .15s ease, transform .15s ease;
    }

        .dn-submit:hover {
            background: var(--hd-primary-dark);
            transform: translateY(-1px);
        }

        .dn-submit:focus-visible {
            box-shadow: 0 0 0 3px rgba(47, 93, 98, 0.3);
        }

    .dn-register {
        text-align: center;
        margin-top: 18px;
        font-size: 0.9rem;
        color: var(--hd-muted);
    }

        .dn-register a {
            color: var(--hd-primary);
            font-weight: 600;
            text-decoration: none;
        }

            .dn-register a:hover {
                text-decoration: underline;
            }

    .dn-errors {
        font-size: 0.85rem;
        color: #B3261E;
        margin-bottom: 14px;
    }

    @@media (max-width: 820px) {
        .dn-card {
            grid-template-columns: 1fr;
        }

        .dn-brand {
            padding: 28px 24px;
        }

        .dn-shades {
            flex-direction: row;
            margin-top: 20px;
            gap: 8px;
        }

        .dn-shade span {
            display: none;
        }

        .dn-form-panel {
            padding: 32px 24px;
        }
    }
</style>
<div class="dn-page">
    <div class="dn-card">
        <div class="dn-brand">
            <div>
                <div class="dn-brand-eyebrow">ElectronicsShop</div>
                <h3>Chào mừng trở lại.</h3>
                <p>Đăng nhập để tiếp tục hành trình khám phá công nghệ của bạn.</p>
            </div>
            <div class="dn-shades">
                <div class="dn-shade"><div class="dn-swatch" style="background:#24262B"></div><span>Đen Titan</span></div>
                <div class="dn-shade"><div class="dn-swatch" style="background:#E3E5E3"></div><span>Bạc Silver</span></div>
                <div class="dn-shade"><div class="dn-swatch" style="background:#A7C1D9"></div><span>Xanh Sierra</span></div>
                <div class="dn-shade"><div class="dn-swatch" style="background:#C97B4A"></div><span>Đồng Ánh Kim</span></div>
            </div>
        </div>

        <div class="dn-form-panel">
            <h1>Đăng nhập hệ thống</h1>
            <p class="dn-sub">Nhập thông tin tài khoản của bạn.</p>

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="dn-alert">@TempData["SuccessMessage"]</div>
            }

            <form asp-action="DangNhap" method="post">
                <div asp-validation-summary="All" class="dn-errors"></div>

                <div class="dn-field">
                    <input type="email" name="email" placeholder=" " maxlength="100" required />
                    <label>Email</label>
                </div>

                <div class="dn-field">
                    <input type="password" name="matKhau" placeholder=" " required />
                    <label>Mật khẩu</label>
                </div>

                <button type="submit" class="dn-submit">Đăng nhập</button>
            </form>

            <p class="dn-register">Chưa có tài khoản? <a asp-action="DangKy">Đăng ký ngay</a></p>
        </div>
    </div>
</div>