@{
    ViewData["Title"] = "Đổi mật khẩu";
    string hoTen = User.Identity?.Name ?? "";
    string email = User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value ?? "";
    string vaiTro = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "";
    string tenVaiTro = vaiTro switch
    {
        "Admin" => "Quản trị viên",
        "Staff" => "Nhân viên",
        "Customer" => "Khách hàng",
        _ => vaiTro
    };
}

<style>
    .tk-page {
        --es-blue: #1E4FBF;
        --es-blue-dark: #0F2F7A;
        --es-navy: #0B1F4B;
        --es-red: #E0282E;
        --es-bg: #F3F5F9;
        --es-text: #1F2937;
        --es-muted: #6B7280;
        --es-border: #E5E7EB;
        padding: 10px 0 50px;
    }
    .tk-crumb { font-size: .8rem; color: var(--es-muted); margin-bottom: 14px; }
    .tk-crumb a { color: var(--es-muted); text-decoration: none; }
    .tk-crumb a:hover { color: var(--es-blue); }
    .tk-crumb b { color: var(--es-blue); }
    .tk-title { font-weight: 800; font-size: 1.6rem; color: var(--es-navy); margin: 0 0 4px; }
    .tk-subtitle { color: var(--es-muted); font-size: .92rem; margin: 0 0 22px; }

    .tk-layout { display: grid; grid-template-columns: 300px 1fr; gap: 22px; align-items: start; }
    .tk-side { display: flex; flex-direction: column; gap: 18px; }

    .tk-profile {
        background: #fff; border: 1px solid var(--es-border); border-radius: 14px; overflow: hidden;
        box-shadow: 0 3px 14px rgba(15,47,122,.06);
    }
    .tk-cover { height: 78px; background: linear-gradient(120deg, var(--es-navy), var(--es-blue)); }
    .tk-profile-body { padding: 0 22px 22px; text-align: center; }
    .tk-avatar {
        width: 84px; height: 84px; border-radius: 50%;
        color: var(--es-blue);
        border: 4px solid #fff; box-shadow: 0 4px 14px rgba(15,47,122,.2);
        display: flex; align-items: center; justify-content: center;
        font-weight: 800; font-size: 2rem;
        margin: -42px auto 10px;
        background: #E8EFFC;
    }
    .tk-name { font-weight: 800; font-size: 1.15rem; color: var(--es-navy); margin: 0 0 8px; word-break: break-word; }
    .tk-role {
        display: inline-flex; align-items: center; gap: 6px;
        background: #E8EFFC; color: var(--es-blue);
        font-weight: 700; font-size: .75rem;
        padding: 5px 14px; border-radius: 20px;
    }
    .tk-role.admin { background: #FDECEC; color: var(--es-red); }
    .tk-mail { color: var(--es-muted); font-size: .85rem; margin-top: 12px; word-break: break-word; }

    .tk-menu {
        background: #fff; border: 1px solid var(--es-border); border-radius: 14px; padding: 8px;
        box-shadow: 0 3px 14px rgba(15,47,122,.06);
    }
    .tk-menu-title { font-size: .7rem; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; color: var(--es-muted); padding: 10px 12px 6px; }
    .tk-menu a {
        display: flex; align-items: center; gap: 12px;
        padding: 11px 12px; border-radius: 8px;
        color: var(--es-text); text-decoration: none; font-weight: 600; font-size: .9rem;
        transition: all .15s ease;
    }
    .tk-menu a i { color: var(--es-blue); font-size: 1.05rem; width: 20px; text-align: center; }
    .tk-menu a:hover { background: #E8EFFC; color: var(--es-blue); }
    .tk-menu a.active { background: var(--es-blue); color: #fff; }
    .tk-menu a.active i { color: #fff; }
    .tk-menu a.danger, .tk-menu a.danger i { color: var(--es-red); }
    .tk-menu a.danger:hover { background: #FDECEC; }
    .tk-menu hr { margin: 6px 8px; border: none; border-top: 1px solid var(--es-border); }

    .tk-main { display: flex; flex-direction: column; gap: 18px; }
    .tk-card {
        background: #fff; border: 1px solid var(--es-border); border-radius: 14px; overflow: hidden;
        box-shadow: 0 3px 14px rgba(15,47,122,.06);
    }
    .tk-card-head {
        display: flex; align-items: center; gap: 12px;
        padding: 16px 24px; border-bottom: 1px solid var(--es-border);
        background: linear-gradient(120deg, var(--es-navy), var(--es-blue)); color: #fff;
    }
    .tk-card-head i { font-size: 1.2rem; }
    .tk-card-head h5 { margin: 0; font-weight: 800; font-size: 1rem; }
    .tk-card-head small { display: block; color: rgba(255,255,255,.75); font-size: .78rem; font-weight: 400; }
    .tk-card-body { padding: 26px 24px; }

    .tk-alert {
        display: flex; align-items: center; gap: 10px;
        background: #E8F6EC; color: #166534; border: 1px solid #BBE5C8;
        border-radius: 10px; padding: 12px 16px; font-size: .9rem; font-weight: 600; margin-bottom: 20px;
    }
    .tk-summary {
        color: #B3261E; font-size: .88rem; margin-bottom: 16px;
        background: #FDECEC; border: 1px solid #F6C7C7; border-radius: 10px; padding: 10px 16px;
    }
    .tk-summary.validation-summary-valid { display: none; }
    .tk-summary ul { margin: 0; padding-left: 18px; }

    .tk-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18px 16px; }
    .tk-group.full { grid-column: 1 / -1; }
    .tk-label { display: block; font-size: .82rem; font-weight: 700; color: var(--es-text); margin-bottom: 6px; }
    .tk-label span { color: var(--es-red); }
    .tk-field {
        display: flex; align-items: center; gap: 10px;
        background: #F3F5F9; border: 1.5px solid transparent; border-radius: 10px;
        padding: 0 14px; transition: all .15s ease;
    }
    .tk-field:focus-within { background: #fff; border-color: var(--es-blue); box-shadow: 0 0 0 3px rgba(30,79,191,.12); }
    .tk-field > i { color: var(--es-muted); }
    .tk-input {
        flex: 1; border: none; background: transparent; outline: none;
        padding: 13px 0; font-size: .95rem; color: var(--es-text); font-family: inherit; min-width: 0;
    }
    .tk-eye { background: none; border: none; color: var(--es-muted); cursor: pointer; padding: 4px; line-height: 1; }
    .tk-eye:hover { color: var(--es-blue); }
    .tk-hint { font-size: .76rem; color: var(--es-muted); margin-top: 5px; display: block; }

    .tk-strength { display: flex; align-items: center; gap: 10px; margin-top: 8px; }
    .tk-bar { flex: 1; height: 6px; border-radius: 6px; background: #E5E7EB; overflow: hidden; }
    .tk-bar > div { height: 100%; width: 0; border-radius: 6px; transition: all .2s ease; background: var(--es-red); }
    .tk-strength small { font-size: .76rem; color: var(--es-muted); min-width: 70px; text-align: right; }

    .tk-actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 26px; padding-top: 20px; border-top: 1px solid var(--es-border); }
    .tk-btn {
        border: none; border-radius: 10px; padding: 12px 24px;
        font-size: .92rem; font-weight: 700; cursor: pointer;
        text-decoration: none; display: inline-flex; align-items: center; gap: 8px;
        transition: all .15s ease;
    }
    .tk-btn.save { background: var(--es-blue); color: #fff; }
    .tk-btn.save:hover { background: var(--es-blue-dark); transform: translateY(-1px); }
    .tk-btn.pass { background: #fff; border: 1.5px solid var(--es-border); color: var(--es-text); }
    .tk-btn.pass:hover { border-color: var(--es-blue); color: var(--es-blue); }

    .tk-tips { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
    .tk-tips li { display: flex; gap: 10px; font-size: .84rem; color: var(--es-text); line-height: 1.5; }
    .tk-tips i { color: var(--es-blue); margin-top: 2px; }

    @@media (max-width: 900px) {
        .tk-layout { grid-template-columns: 1fr; }
    }
    @@media (max-width: 576px) {
        .tk-grid, .tk-tips { grid-template-columns: 1fr; }
        .tk-card-body { padding: 20px 16px; }
    }
</style>

<div class="container tk-page">

    <div class="tk-crumb">
        <a asp-controller="Home" asp-action="Index"><i class="bi bi-house-door"></i> Trang chủ</a>
        &nbsp;/&nbsp;
        <a asp-controller="TaiKhoan" asp-action="ThongTin">Thông tin tài khoản</a>
        &nbsp;/&nbsp; <b>Đổi mật khẩu</b>
    </div>

    <h1 class="tk-title">Đổi mật khẩu</h1>
    <p class="tk-subtitle">Cập nhật mật khẩu định kỳ để bảo vệ tài khoản của bạn an toàn hơn.</p>

    <div class="tk-layout">

        <!-- ===== CỘT TRÁI ===== -->
        <aside class="tk-side">

            <div class="tk-profile">
                <div class="tk-cover"></div>
                <div class="tk-profile-body">
                    <div class="tk-avatar">@(string.IsNullOrEmpty(hoTen) ? "?" : hoTen.Trim().Substring(0, 1).ToUpper())</div>
                    <h3 class="tk-name">@hoTen</h3>
                    <span class="tk-role @(vaiTro == "Admin" ? "admin" : "")">
                        <i class="bi bi-patch-check-fill"></i> @tenVaiTro
                    </span>
                    <div class="tk-mail"><i class="bi bi-envelope"></i> @email</div>
                </div>
            </div>

            <nav class="tk-menu">
                <div class="tk-menu-title">Tài khoản của tôi</div>
                <a asp-controller="TaiKhoan" asp-action="ThongTin"><i class="bi bi-person-vcard"></i> Hồ sơ cá nhân</a>
                <a asp-controller="DonHang" asp-action="LichSu"><i class="bi bi-receipt"></i> Đơn hàng của tôi</a>
                <a asp-controller="GioHang" asp-action="Index"><i class="bi bi-cart3"></i> Giỏ hàng</a>
                <a asp-controller="TaiKhoan" asp-action="DoiMatKhau" class="active"><i class="bi bi-key"></i> Đổi mật khẩu</a>

                @if (User.IsInRole("Admin"))
                {
                    <hr />
                    <div class="tk-menu-title">Quản trị</div>
                    <a asp-controller="AdminSanPham" asp-action="Index"><i class="bi bi-box-seam"></i> Quản lý sản phẩm</a>
                    <a asp-controller="DonHang" asp-action="Index"><i class="bi bi-cart-check"></i> Quản lý đơn hàng</a>
                }

                <hr />
                <a asp-controller="TaiKhoan" asp-action="DangXuat" class="danger"><i class="bi bi-box-arrow-right"></i> Đăng xuất</a>
            </nav>
        </aside>

        <!-- ===== CỘT PHẢI ===== -->
        <div class="tk-main">

            <div class="tk-card">
                <div class="tk-card-head">
                    <i class="bi bi-key-fill"></i>
                    <div>
                        <h5>Đổi mật khẩu</h5>
                        <small>Nhập mật khẩu hiện tại và mật khẩu mới</small>
                    </div>
                </div>
                <div class="tk-card-body">

                    @if (TempData["ThongBao"] != null)
                    {
                        <div class="tk-alert"><i class="bi bi-check-circle-fill"></i> @TempData["ThongBao"]</div>
                    }

                    <form asp-action="DoiMatKhau" method="post" id="formDoiMatKhau">
                        <div asp-validation-summary="All" class="tk-summary"></div>

                        <div class="tk-grid">

                            <div class="tk-group full">
                                <label class="tk-label" for="matKhauCu">Mật khẩu hiện tại <span>*</span></label>
                                <div class="tk-field">
                                    <i class="bi bi-lock"></i>
                                    <input type="password" name="matKhauCu" id="matKhauCu" class="tk-input"
                                           placeholder="Nhập mật khẩu hiện tại" autocomplete="current-password" required />
                                    <button type="button" class="tk-eye" data-target="matKhauCu" aria-label="Hiện/ẩn mật khẩu">
                                        <i class="bi bi-eye"></i>
                                    </button>
                                </div>
                            </div>

                            <div class="tk-group">
                                <label class="tk-label" for="matKhauMoi">Mật khẩu mới <span>*</span></label>
                                <div class="tk-field">
                                    <i class="bi bi-shield-lock"></i>
                                    <input type="password" name="matKhauMoi" id="matKhauMoi" class="tk-input"
                                           placeholder="Ít nhất 6 ký tự" minlength="6" autocomplete="new-password" required />
                                    <button type="button" class="tk-eye" data-target="matKhauMoi" aria-label="Hiện/ẩn mật khẩu">
                                        <i class="bi bi-eye"></i>
                                    </button>
                                </div>
                                <div class="tk-strength">
                                    <div class="tk-bar"><div id="strengthBar"></div></div>
                                    <small id="strengthText"></small>
                                </div>
                            </div>

                            <div class="tk-group">
                                <label class="tk-label" for="xacNhanMatKhauMoi">Xác nhận mật khẩu mới <span>*</span></label>
                                <div class="tk-field">
                                    <i class="bi bi-shield-check"></i>
                                    <input type="password" name="xacNhanMatKhauMoi" id="xacNhanMatKhauMoi" class="tk-input"
                                           placeholder="Nhập lại mật khẩu mới" autocomplete="new-password" required />
                                    <button type="button" class="tk-eye" data-target="xacNhanMatKhauMoi" aria-label="Hiện/ẩn mật khẩu">
                                        <i class="bi bi-eye"></i>
                                    </button>
                                </div>
                                <span class="tk-hint" id="matchHint"></span>
                            </div>
                        </div>

                        <div class="tk-actions">
                            <button type="submit" class="tk-btn save"><i class="bi bi-check2-circle"></i> Đổi mật khẩu</button>
                            <a asp-controller="TaiKhoan" asp-action="ThongTin" class="tk-btn pass"><i class="bi bi-arrow-left"></i> Quay lại</a>
                        </div>
                    </form>
                </div>
            </div>

            <div class="tk-card">
                <div class="tk-card-head">
                    <i class="bi bi-shield-lock"></i>
                    <div>
                        <h5>Lưu ý khi đặt mật khẩu</h5>
                        <small>Giữ tài khoản của bạn luôn an toàn</small>
                    </div>
                </div>
                <div class="tk-card-body">
                    <ul class="tk-tips">
                        <li><i class="bi bi-check-circle"></i>Mật khẩu mới phải có ít nhất 6 ký tự.</li>
                        <li><i class="bi bi-check-circle"></i>Mật khẩu mới phải khác mật khẩu hiện tại.</li>
                        <li><i class="bi bi-check-circle"></i>Dùng cả chữ hoa, chữ thường, số và ký tự đặc biệt.</li>
                        <li><i class="bi bi-check-circle"></i>Không chia sẻ mật khẩu với bất kỳ ai.</li>
                    </ul>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        // Hiện / ẩn mật khẩu
        document.querySelectorAll('.tk-eye').forEach(function (btn) {
            btn.addEventListener('click', function () {
                var input = document.getElementById(btn.dataset.target);
                var icon = btn.querySelector('i');
                var show = input.type === 'password';
                input.type = show ? 'text' : 'password';
                icon.className = show ? 'bi bi-eye-slash' : 'bi bi-eye';
            });
        });

        // Đo độ mạnh mật khẩu
        var moi = document.getElementById('matKhauMoi');
        var xacNhan = document.getElementById('xacNhanMatKhauMoi');
        var bar = document.getElementById('strengthBar');
        var text = document.getElementById('strengthText');
        var hint = document.getElementById('matchHint');

        moi.addEventListener('input', function () {
            var v = moi.value, score = 0;
            if (v.length >= 6) score++;
            if (v.length >= 10) score++;
            if (/[a-z]/.test(v) && /[A-Z]/.test(v)) score++;
            if (/\d/.test(v)) score++;
            if (/[^A-Za-z0-9]/.test(v)) score++;

            var levels = [
                { w: '0%',   c: '#E5E7EB', t: '' },
                { w: '25%',  c: '#E0282E', t: 'Yếu' },
                { w: '50%',  c: '#F59E0B', t: 'Trung bình' },
                { w: '75%',  c: '#1E4FBF', t: 'Khá' },
                { w: '100%', c: '#16A34A', t: 'Mạnh' }
            ];
            var lv = v.length === 0 ? levels[0] : levels[Math.min(Math.max(score - 1, 1), 4)];
            bar.style.width = lv.w;
            bar.style.background = lv.c;
            text.textContent = lv.t;
            kiemTraKhop();
        });

        // Kiểm tra xác nhận khớp
        function kiemTraKhop() {
            if (!xacNhan.value) { hint.textContent = ''; return; }
            if (xacNhan.value === moi.value) {
                hint.textContent = 'Mật khẩu xác nhận khớp.';
                hint.style.color = '#16A34A';
            } else {
                hint.textContent = 'Mật khẩu xác nhận chưa khớp.';
                hint.style.color = '#E0282E';
            }
        }
        xacNhan.addEventListener('input', kiemTraKhop);
    </script>
}