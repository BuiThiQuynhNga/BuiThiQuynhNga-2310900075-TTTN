@model ElectronicsShop.Models.User
@{
    ViewData["Title"] = "Đăng ký";
}
<style>
    .dk-page {
        --hd-primary: #2F5D62;
        --hd-primary-dark: #22454A;
        --hd-accent: #C97B4A;
        --hd-bg: #F7F7F5;
        --hd-card: #FFFFFF;
        --hd-text: #24262B;
        --hd-muted: #6B7076;
        --hd-border: #E7E5E1;
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: calc(100vh - 120px);
        padding: 48px 16px;
        background: var(--hd-bg);
    }
    .dk-card {
        display: grid;
        grid-template-columns: 0.85fr 1.15fr;
        max-width: 920px;
        width: 100%;
        background: var(--hd-card);
        border-radius: 20px;
        overflow: hidden;
        border: 1px solid var(--hd-border);
        box-shadow: 0 20px 50px rgba(34, 69, 74, 0.12);
    }
    .dk-brand {
        background: linear-gradient(160deg, var(--hd-primary-dark) 0%, #16292C 100%);
        padding: 40px 32px;
        color: #fff;
        display: flex;
        flex-direction: column;
        gap: 28px;
    }
    .dk-brand-eyebrow {
        font-size: 0.75rem;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: rgba(255, 255, 255, 0.55);
        font-weight: 600;
    }
    .dk-brand h3 {
        font-family: 'Poppins', sans-serif;
        font-weight: 800;
        font-size: 1.55rem;
        line-height: 1.3;
        margin: 8px 0 0;
    }
    .dk-brand p {
        color: rgba(255, 255, 255, 0.72);
        font-size: 0.92rem;
        max-width: 26ch;
        margin: 12px 0 0;
    }
    .dk-shades {
        margin-top: auto;
        display: flex;
        flex-direction: column;
        gap: 8px;
    }
    .dk-shade {
        display: flex;
        align-items: center;
        gap: 12px;
        opacity: 0;
        transform: translateX(-8px);
        animation: dk-fade .5s ease forwards;
    }
    .dk-shade:nth-child(1) {
        animation-delay: .05s;
    }
    .dk-shade:nth-child(2) {
        animation-delay: .12s;
    }
    .dk-shade:nth-child(3) {
        animation-delay: .19s;
    }
    .dk-shade:nth-child(4) {
        animation-delay: .26s;
    }
    .dk-shade:nth-child(5) {
        animation-delay: .33s;
    }
    @@keyframes dk-fade {
        to {
            opacity: 1;
            transform: translateX(0);
        }
    }
    .dk-swatch {
        width: 28px;
        height: 28px;
        border-radius: 8px;
        flex-shrink: 0;
        box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.15);
    }
    .dk-shade span {
        font-size: 0.82rem;
        color: rgba(255, 255, 255, 0.8);
    }
    .dk-form-panel {
        padding: 44px 40px;
    }
    .dk-form-panel h1 {
        font-family: 'Poppins', sans-serif;
        font-weight: 800;
        font-size: 1.5rem;
        color: var(--hd-text);
        margin: 0 0 4px;
    }
    .dk-sub {
        color: var(--hd-muted);
        font-size: 0.92rem;
        margin: 0 0 28px;
    }
    .dk-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 18px 14px;
    }
    .dk-field {
        position: relative;
    }
    .dk-field.full {
        grid-column: 1 / -1;
    }
    .dk-field input {
        width: 100%;
        border: 1.5px solid var(--hd-border);
        border-radius: 10px;
        padding: 18px 14px 8px;
        font-size: 0.95rem;
        color: var(--hd-text);
        background: #fff;
        transition: border-color .15s ease, box-shadow .15s ease;
        box-sizing: border-box;
    }
    .dk-field input:focus {
        outline: none;
        border-color: var(--hd-primary);
        box-shadow: 0 0 0 3px rgba(47, 93, 98, 0.12);
    }
    .dk-field label {
        position: absolute;
        left: 14px;
        top: 14px;
        font-size: 0.95rem;
        color: var(--hd-muted);
        pointer-events: none;
        transition: all .15s ease;
    }
    .dk-field input:focus + label,
    .dk-field input:not(:placeholder-shown) + label {
        top: 5px;
        font-size: 0.7rem;
        color: var(--hd-primary);
        font-weight: 600;
    }
    .dk-submit {
        margin-top: 22px;
        width: 100%;
        border: none;
        border-radius: 10px;
        padding: 14px;
        font-weight: 700;
        font-size: 1rem;
        color: #fff;
        background: var(--hd-primary);
        cursor: pointer;
        transition: background .15s ease, transform .15s ease;
    }
    .dk-submit:hover {
        background: var(--hd-primary-dark);
        transform: translateY(-1px);
    }
    .dk-login {
        text-align: center;
        margin-top: 18px;
        font-size: 0.9rem;
        color: var(--hd-muted);
    }
    .dk-login a {
        color: var(--hd-primary);
        font-weight: 600;
        text-decoration: none;
    }
    .dk-login a:hover {
        text-decoration: underline;
    }
    .dk-errors {
        font-size: 0.85rem;
        color: #B3261E;
        margin-bottom: 14px;
    }
    .dk-errors ul {
        margin: 0;
        padding-left: 20px;
    }
    .dk-field-error {
        color: #B3261E;
        font-size: 0.75rem;
        margin-top: 5px;
        display: block;
    }
    @@media (prefers-reduced-motion: reduce) {
        .dk-shade {
            animation: none;
            opacity: 1;
            transform: none;
        }
    }
    @@media (max-width: 820px) {
        .dk-card {
            grid-template-columns: 1fr;
        }
        .dk-brand {
            padding: 28px 24px;
        }
        .dk-shades {
            flex-direction: row;
            margin-top: 20px;
            gap: 8px;
        }
        .dk-shade span {
            display: none;
        }
        .dk-grid {
            grid-template-columns: 1fr;
        }
        .dk-form-panel {
            padding: 32px 24px;
        }
    }
</style>
<div class="dk-page">
    <div class="dk-card">
        <div class="dk-brand">
            <div>
                <div class="dk-brand-eyebrow">ElectronicsShop</div>
                <h3>Khám phá công nghệ đỉnh cao.</h3>
                <p>Tạo tài khoản để quản lý đơn hàng, lưu sản phẩm yêu thích và nhận ưu đãi công nghệ riêng cho bạn.</p>
            </div>
            <div class="dk-shades">
                <div class="dk-shade">
                    <div class="dk-swatch" style="background:#24262B"></div>
                    <span>Đen Titan</span>
                </div>
                <div class="dk-shade">
                    <div class="dk-swatch" style="background:#E3E5E3"></div>
                    <span>Bạc Silver</span>
                </div>
                <div class="dk-shade">
                    <div class="dk-swatch" style="background:#A7C1D9"></div>
                    <span>Xanh Sierra</span>
                </div>
                <div class="dk-shade">
                    <div class="dk-swatch" style="background:#C97B4A"></div>
                    <span>Đồng Ánh Kim</span>
                </div>
                <div class="dk-shade">
                    <div class="dk-swatch" style="background:#F9F6F0"></div>
                    <span>Trắng Starlight</span>
                </div>
            </div>
        </div>
        <div class="dk-form-panel">
            <h1>Tạo tài khoản mới</h1>
            <p class="dk-sub">Chỉ mất chưa đầy một phút.</p>
            <form asp-controller="TaiKhoan" asp-action="DangKy" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="All" class="dk-errors"></div>
                <div class="dk-grid">
                    <div class="dk-field full">
                        <input type="text" name="fullName" id="fullName" placeholder=" " maxlength="100" required />
                        <label for="fullName">Họ và tên</label>
                        @Html.ValidationMessage("FullName", null, new { @class = "dk-field-error" })
                    </div>
                    <div class="dk-field full">
                        <input type="email" name="email" id="email" placeholder=" " maxlength="100" required />
                        <label for="email">Email</label>
                        @Html.ValidationMessage("Email", null, new { @class = "dk-field-error" })
                    </div>
                    <div class="dk-field">
                        <input type="password" name="matKhau" id="matKhau" placeholder=" " required autocomplete="new-password" />
                        <label for="matKhau">Mật khẩu</label>
                        @Html.ValidationMessage("matKhau", null, new { @class = "dk-field-error" })
                    </div>
                    <div class="dk-field">
                        <input type="password" name="XacNhanMatKhau" id="XacNhanMatKhau" placeholder=" " required autocomplete="new-password" />
                        <label for="XacNhanMatKhau">Xác nhận mật khẩu</label>
                        @Html.ValidationMessage("XacNhanMatKhau", null, new { @class = "dk-field-error" })
                    </div>
                    <div class="dk-field">
                        <input type="text" name="phone" id="phone" placeholder=" " maxlength="15" />
                        <label for="phone">Số điện thoại</label>
                    </div>
                    <div class="dk-field">
                        <input type="text" name="address" id="address" placeholder=" " maxlength="255" />
                        <label for="address">Địa chỉ</label>
                    </div>
                </div>
                <button type="submit" class="dk-submit">Đăng ký</button>
            </form>
            <p class="dk-login">Đã có tài khoản? <a asp-controller="TaiKhoan" asp-action="DangNhap">Đăng nhập ngay</a></p>
        </div>
    </div>
</div>