@model ElectronicsShop.Models.User
@{
    ViewData["Title"] = "Đăng ký";
}
<style>
    .dk-page {
        --es-blue: #1E4FBF;
        --es-blue-dark: #0F2F7A;
        --es-navy: #0B1F4B;
        --es-red: #E0282E;
        --es-bg: #F3F5F9;
        --es-text: #1F2937;
        --es-muted: #6B7280;
        --es-border: #E5E7EB;
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 24px 16px 48px;
    }

    .dk-crumb {
        max-width: 1000px;
        margin: 0 auto 14px;
        font-size: .8rem;
        color: var(--es-muted);
    }
    .dk-crumb a { color: var(--es-muted); text-decoration: none; }
    .dk-crumb a:hover { color: var(--es-blue); }
    .dk-crumb b { color: var(--es-blue); }

    .dk-card {
        display: grid;
        grid-template-columns: 0.85fr 1.15fr;
        max-width: 1000px;
        width: 100%;
        background: #fff;
        border-radius: 18px;
        overflow: hidden;
        border: 1px solid var(--es-border);
        box-shadow: 0 20px 50px rgba(15, 47, 122, 0.14);
    }

    /* Cột trái */
    .dk-brand {
        background: linear-gradient(160deg, var(--es-blue) 0%, var(--es-navy) 100%);
        padding: 40px 34px;
        color: #fff;
        display: flex;
        flex-direction: column;
        gap: 22px;
    }
    .dk-badge {
        align-self: flex-start;
        background: rgba(255,255,255,.14);
        border: 1px solid rgba(255,255,255,.22);
        border-radius: 20px;
        padding: 6px 14px;
        font-size: .68rem;
        font-weight: 700;
        letter-spacing: .08em;
        text-transform: uppercase;
    }
    .dk-brand h3 {
        font-weight: 800;
        font-size: 1.55rem;
        line-height: 1.3;
        margin: 0;
        text-transform: uppercase;
    }
    .dk-brand p { color: rgba(255,255,255,.8); font-size: .9rem; margin: 0; }
    .dk-points { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 14px; }
    .dk-points li { display: flex; gap: 12px; align-items: flex-start; font-size: .88rem; color: rgba(255,255,255,.92); line-height: 1.5; }
    .dk-points i {
        flex-shrink: 0;
        width: 22px; height: 22px;
        border-radius: 50%;
        background: rgba(255,255,255,.2);
        display: flex; align-items: center; justify-content: center;
        font-size: .8rem;
        margin-top: 1px;
    }
    .dk-ssl {
        margin-top: auto;
        padding-top: 14px;
        border-top: 1px solid rgba(255,255,255,.18);
        font-size: .78rem;
        color: rgba(255,255,255,.75);
    }
    .dk-ssl i { margin-right: 6px; }

    /* Cột phải */
    .dk-form-panel { padding: 38px 44px; }
    .dk-logo { display: flex; align-items: center; gap: 10px; margin-bottom: 20px; }
    .dk-logo-icon {
        width: 38px; height: 38px; border-radius: 10px;
        background: linear-gradient(135deg, var(--es-blue), var(--es-blue-dark));
        color: #fff; display: flex; align-items: center; justify-content: center; font-size: 1.15rem;
    }
    .dk-logo-text { font-weight: 800; color: var(--es-navy); line-height: 1.1; }
    .dk-logo-text small { display: block; font-size: .6rem; color: var(--es-red); letter-spacing: .14em; text-transform: uppercase; }

    .dk-form-panel h1 { font-weight: 800; font-size: 1.7rem; color: var(--es-navy); margin: 0 0 4px; }
    .dk-sub { color: var(--es-muted); font-size: .9rem; margin: 0 0 22px; }

    .dk-errors { font-size: .85rem; color: #B3261E; margin-bottom: 12px; }
    .dk-errors ul { margin: 0; padding-left: 20px; }

    .dk-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px 14px;
    }
    .dk-group.full { grid-column: 1 / -1; }
    .dk-label { display: block; font-size: .82rem; font-weight: 700; color: var(--es-text); margin-bottom: 6px; }
    .dk-label span { color: var(--es-red); }
    .dk-input {
        display: flex;
        align-items: center;
        gap: 10px;
        background: #F3F5F9;
        border: 1.5px solid transparent;
        border-radius: 10px;
        padding: 0 14px;
        transition: all .15s ease;
    }
    .dk-input:focus-within { background: #fff; border-color: var(--es-blue); box-shadow: 0 0 0 3px rgba(30,79,191,.12); }
    .dk-input > i { color: var(--es-muted); font-size: 1rem; }
    .dk-input input {
        flex: 1;
        border: none;
        background: transparent;
        padding: 13px 0;
        font-size: .95rem;
        color: var(--es-text);
        outline: none;
        min-width: 0;
    }
    .dk-field-error { color: #B3261E; font-size: .75rem; margin-top: 5px; display: block; }

    .dk-note {
        display: flex; gap: 8px; align-items: center;
        background: #F3F5F9; border-radius: 8px;
        padding: 10px 12px; font-size: .78rem; color: var(--es-muted);
        margin-top: 16px;
    }
    .dk-note i { color: var(--es-blue); }

    .dk-submit {
        margin-top: 18px;
        width: 100%;
        border: none;
        border-radius: 10px;
        padding: 14px;
        font-weight: 800;
        font-size: 1rem;
        letter-spacing: .04em;
        text-transform: uppercase;
        color: #fff;
        background: var(--es-blue);
        cursor: pointer;
        transition: all .15s ease;
    }
    .dk-submit:hover { background: var(--es-blue-dark); transform: translateY(-1px); }

    .dk-login { text-align: center; margin-top: 18px; font-size: .9rem; color: var(--es-muted); }
    .dk-login a { color: var(--es-blue); font-weight: 800; text-decoration: none; }
    .dk-login a:hover { text-decoration: underline; }

    @@media (max-width: 860px) {
        .dk-card { grid-template-columns: 1fr; }
        .dk-brand { padding: 28px 24px; }
        .dk-form-panel { padding: 30px 22px; }
        .dk-grid { grid-template-columns: 1fr; }
    }
</style>

<div class="dk-crumb">
    <a asp-controller="Home" asp-action="Index"><i class="bi bi-house-door"></i> Trang chủ</a>
    &nbsp;/&nbsp; <b>Đăng ký</b>
</div>

<div class="dk-page">
    <div class="dk-card">
        <div class="dk-brand">
            <span class="dk-badge"><i class="bi bi-shield-check"></i> Bảo mật hệ thống chuẩn quốc tế</span>
            <div>
                <h3>Khám phá công nghệ đỉnh cao cùng ElectronicsShop</h3>
            </div>
            <p>Tạo tài khoản để quản lý đơn hàng, theo dõi sản phẩm yêu thích và nhận ưu đãi công nghệ riêng cho bạn.</p>
            <ul class="dk-points">
                <li><i class="bi bi-check"></i>Theo dõi trạng thái đơn hàng và lịch sử mua sắm 24/7</li>
                <li><i class="bi bi-check"></i>Nhận mã giảm giá và ưu đãi dành riêng cho thành viên</li>
                <li><i class="bi bi-check"></i>Hỗ trợ kỹ thuật ưu tiên và tra cứu bảo hành nhanh chóng</li>
                <li><i class="bi bi-check"></i>Thanh toán tiện lợi, giao hàng nhanh toàn quốc</li>
            </ul>
            <div class="dk-ssl"><i class="bi bi-shield-lock"></i>Mã hóa SSL 256-bit an toàn tuyệt đối</div>
        </div>

        <div class="dk-form-panel">
            <div class="dk-logo">
                <span class="dk-logo-icon"><i class="bi bi-laptop"></i></span>
                <span class="dk-logo-text">ElectronicsShop<small>Công nghệ chính hãng</small></span>
            </div>

            <h1>Tạo tài khoản mới</h1>
            <p class="dk-sub">Chỉ mất chưa đầy một phút.</p>

            <form asp-controller="TaiKhoan" asp-action="DangKy" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="All" class="dk-errors"></div>

                <div class="dk-grid">
                    <div class="dk-group full">
                        <label class="dk-label" for="fullName">Họ và tên <span>*</span></label>
                        <div class="dk-input">
                            <i class="bi bi-person"></i>
                            <input type="text" name="fullName" id="fullName" placeholder="Nhập họ và tên" maxlength="100" required />
                        </div>
                        @Html.ValidationMessage("FullName", null, new { @class = "dk-field-error" })
                    </div>

                    <div class="dk-group full">
                        <label class="dk-label" for="email">Email <span>*</span></label>
                        <div class="dk-input">
                            <i class="bi bi-at"></i>
                            <input type="email" name="email" id="email" placeholder="Nhập địa chỉ email" maxlength="100" required />
                        </div>
                        @Html.ValidationMessage("Email", null, new { @class = "dk-field-error" })
                    </div>

                    <div class="dk-group">
                        <label class="dk-label" for="matKhau">Mật khẩu <span>*</span></label>
                        <div class="dk-input">
                            <i class="bi bi-lock"></i>
                            <input type="password" name="matKhau" id="matKhau" placeholder="Nhập mật khẩu" required autocomplete="new-password" />
                        </div>
                        @Html.ValidationMessage("matKhau", null, new { @class = "dk-field-error" })
                    </div>

                    <div class="dk-group">
                        <label class="dk-label" for="XacNhanMatKhau">Xác nhận mật khẩu <span>*</span></label>
                        <div class="dk-input">
                            <i class="bi bi-lock-fill"></i>
                            <input type="password" name="XacNhanMatKhau" id="XacNhanMatKhau" placeholder="Nhập lại mật khẩu" required autocomplete="new-password" />
                        </div>
                        @Html.ValidationMessage("XacNhanMatKhau", null, new { @class = "dk-field-error" })
                    </div>

                    <div class="dk-group">
                        <label class="dk-label" for="phone">Số điện thoại</label>
                        <div class="dk-input">
                            <i class="bi bi-telephone"></i>
                            <input type="text" name="phone" id="phone" placeholder="Nhập số điện thoại" maxlength="15" />
                        </div>
                    </div>

                    <div class="dk-group">
                        <label class="dk-label" for="address">Địa chỉ</label>
                        <div class="dk-input">
                            <i class="bi bi-geo-alt"></i>
                            <input type="text" name="address" id="address" placeholder="Nhập địa chỉ" maxlength="255" />
                        </div>
                    </div>
                </div>

                <div class="dk-note"><i class="bi bi-shield-check"></i>Thông tin đăng ký được bảo mật theo tiêu chuẩn an toàn dữ liệu.</div>

                <button type="submit" class="dk-submit">Đăng ký <i class="bi bi-arrow-right"></i></button>
            </form>

            <p class="dk-login">Đã có tài khoản? <a asp-controller="TaiKhoan" asp-action="DangNhap">Đăng nhập ngay</a></p>
        </div>
    </div>
</div>