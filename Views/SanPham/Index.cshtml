@* Views/SanPham/Index.cshtml (Giao diện khách hàng) *@
@model IEnumerable<ElectronicsShop.Models.Product>

@{
    ViewData["Title"] = "Danh sách sản phẩm";

    // Chuẩn hóa đường dẫn ảnh: chấp nhận tên trơn, "images/...", "/..." hoặc link http
    string LayAnh(string? url)
    {
        if (string.IsNullOrWhiteSpace(url)) return "/images/no-image.png";
        url = url.Trim();
        if (url.StartsWith("http") || url.StartsWith("/")) return url;
        if (url.StartsWith("images/")) return "/" + url;
        return "/images/" + url;
    }

    var dsSanPham = Model.ToList();
    var dsDanhMuc = dsSanPham
        .GroupBy(p => p.Category?.CategoryName ?? "Khác")
        .OrderBy(g => g.Key)
        .Select(g => new { Ten = g.Key, SoLuong = g.Count() })
        .ToList();
}

<style>
    .sp-page {
        --es-blue: #1E4FBF;
        --es-blue-dark: #0F2F7A;
        --es-navy: #0B1F4B;
        --es-red: #E0282E;
        --es-green: #16A34A;
        --es-bg: #F3F5F9;
        --es-text: #1F2937;
        --es-muted: #6B7280;
        --es-border: #E5E7EB;
        padding: 10px 0 50px;
    }
    .sp-crumb { font-size: .8rem; color: var(--es-muted); margin-bottom: 14px; }
    .sp-crumb a { color: var(--es-muted); text-decoration: none; }
    .sp-crumb a:hover { color: var(--es-blue); }
    .sp-crumb b { color: var(--es-blue); }
    .sp-title { font-weight: 800; font-size: 1.8rem; color: var(--es-navy); margin: 0 0 4px; }
    .sp-subtitle { color: var(--es-muted); font-size: .9rem; margin: 0 0 22px; }

    .sp-layout { display: grid; grid-template-columns: 260px 1fr; gap: 22px; align-items: start; }

    /* ===== BỘ LỌC ===== */
    .sp-filter {
        background: #fff; border: 1px solid var(--es-border); border-radius: 14px; padding: 20px;
        box-shadow: 0 3px 14px rgba(15,47,122,.06); position: sticky; top: 90px;
    }
    .sp-filter-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 14px; }
    .sp-filter-head h5 { margin: 0; font-weight: 800; font-size: 1.05rem; color: var(--es-navy); display: flex; align-items: center; gap: 8px; }
    .sp-filter-head h5 i { color: var(--es-blue); }
    .sp-reset { background: none; border: none; color: var(--es-muted); font-size: .78rem; cursor: pointer; padding: 0; }
    .sp-reset:hover { color: var(--es-red); }
    .sp-fgroup { padding: 14px 0; border-top: 1px solid var(--es-border); }
    .sp-fgroup:first-of-type { border-top: none; padding-top: 4px; }
    .sp-ftitle { font-size: .7rem; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; color: var(--es-muted); margin-bottom: 10px; }
    .sp-check {
        display: flex; align-items: center; gap: 10px; padding: 6px 0;
        font-size: .88rem; color: var(--es-text); cursor: pointer; user-select: none;
    }
    .sp-check input { width: 16px; height: 16px; accent-color: var(--es-blue); cursor: pointer; margin: 0; }
    .sp-check .cnt {
        margin-left: auto; background: #EEF0F4; color: var(--es-muted);
        font-size: .7rem; font-weight: 700; padding: 2px 8px; border-radius: 10px;
    }
    .sp-check:hover { color: var(--es-blue); }
    .sp-btn-apply {
        width: 100%; border: none; border-radius: 10px; padding: 12px;
        background: var(--es-blue); color: #fff; font-weight: 700; font-size: .88rem; cursor: pointer;
        display: flex; align-items: center; justify-content: center; gap: 8px; margin-top: 6px;
        transition: all .15s ease;
    }
    .sp-btn-apply:hover { background: var(--es-blue-dark); }
    .sp-btn-clear {
        width: 100%; border: 1.5px solid var(--es-border); border-radius: 10px; padding: 11px;
        background: #fff; color: var(--es-muted); font-weight: 700; font-size: .85rem; cursor: pointer; margin-top: 8px;
        transition: all .15s ease;
    }
    .sp-btn-clear:hover { border-color: var(--es-red); color: var(--es-red); }

    /* ===== THANH CÔNG CỤ ===== */
    .sp-toolbar {
        display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap;
        background: #fff; border: 1px solid var(--es-border); border-radius: 12px; padding: 10px 16px;
        margin-bottom: 18px; box-shadow: 0 3px 14px rgba(15,47,122,.04);
    }
    .sp-chips { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; font-size: .82rem; color: var(--es-muted); }
    .sp-chip {
        background: #E8EFFC; color: var(--es-blue); font-weight: 700; font-size: .78rem;
        padding: 5px 12px; border-radius: 20px; display: inline-flex; align-items: center; gap: 6px;
    }
    .sp-sort { display: flex; align-items: center; gap: 8px; font-size: .82rem; color: var(--es-muted); }
    .sp-sort select {
        border: 1.5px solid var(--es-border); border-radius: 8px; padding: 7px 10px;
        font-size: .85rem; font-weight: 600; color: var(--es-text); background: #fff; outline: none;
    }
    .sp-sort select:focus { border-color: var(--es-blue); }

    /* ===== LƯỚI SẢN PHẨM ===== */
    .sp-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
    .sp-card {
        background: #fff; border: 1px solid var(--es-border); border-radius: 14px; overflow: hidden;
        display: flex; flex-direction: column;
        box-shadow: 0 3px 14px rgba(15,47,122,.05); transition: all .2s ease;
    }
    .sp-card:hover { transform: translateY(-3px); box-shadow: 0 10px 26px rgba(15,47,122,.14); border-color: #C9D6F3; }
    .sp-thumb { display: block; background: var(--es-bg); margin: 10px 10px 0; border-radius: 10px; overflow: hidden; position: relative; }
    .sp-thumb img { width: 100%; height: 200px; object-fit: cover; display: block; transition: transform .3s ease; }
    .sp-card:hover .sp-thumb img { transform: scale(1.04); }
    .sp-badge {
        position: absolute; top: 10px; left: 10px; z-index: 2;
        background: var(--es-navy); color: #fff; font-size: .7rem; font-weight: 700;
        padding: 4px 10px; border-radius: 6px;
    }
    .sp-badge.out { background: var(--es-red); }
    .sp-body { padding: 14px 16px 6px; flex: 1; }
    .sp-meta { display: flex; align-items: center; justify-content: space-between; gap: 8px; font-size: .7rem; font-weight: 700; margin-bottom: 8px; }
    .sp-cat { color: var(--es-muted); text-transform: uppercase; letter-spacing: .04em; }
    .sp-stock { color: var(--es-green); display: inline-flex; align-items: center; gap: 4px; white-space: nowrap; }
    .sp-stock.out { color: var(--es-red); }
    .sp-stock::before { content: ""; width: 6px; height: 6px; border-radius: 50%; background: currentColor; }
    .sp-name {
        font-size: .98rem; font-weight: 700; color: var(--es-navy); margin: 0 0 8px; line-height: 1.4;
        display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; min-height: 2.8em;
    }
    .sp-name a { color: inherit; text-decoration: none; }
    .sp-name a:hover { color: var(--es-blue); }
    .sp-desc {
        background: #F3F5F9; border-radius: 8px; padding: 8px 10px; font-size: .78rem; color: var(--es-muted);
        line-height: 1.5; min-height: 3.6em; margin-bottom: 12px;
    }
    .sp-price-row { display: flex; align-items: baseline; justify-content: space-between; gap: 8px; }
    .sp-price { font-size: 1.35rem; font-weight: 800; color: var(--es-red); }
    .sp-qty { font-size: .75rem; color: var(--es-muted); }
    .sp-foot { padding: 12px 16px 16px; display: flex; gap: 8px; }
    .sp-foot form { flex: 1; margin: 0; }
    .sp-btn {
        border: none; border-radius: 10px; padding: 11px 14px; font-size: .85rem; font-weight: 700;
        cursor: pointer; text-decoration: none; display: inline-flex; align-items: center; justify-content: center; gap: 6px;
        transition: all .15s ease; width: 100%;
    }
    .sp-btn.cart { background: var(--es-blue); color: #fff; }
    .sp-btn.cart:hover { background: var(--es-blue-dark); transform: translateY(-1px); }
    .sp-btn.disabled { background: #E5E7EB; color: var(--es-muted); cursor: not-allowed; }
    .sp-btn.detail { background: #fff; border: 1.5px solid var(--es-border); color: var(--es-blue); width: 44px; flex-shrink: 0; padding: 0; }
    .sp-btn.detail:hover { border-color: var(--es-blue); background: #E8EFFC; }

    .sp-empty {
        display: none; text-align: center; padding: 50px 20px; background: #fff;
        border: 1px dashed var(--es-border); border-radius: 14px; color: var(--es-muted);
    }
    .sp-empty i { font-size: 2.4rem; color: var(--es-blue); display: block; margin-bottom: 8px; }

    @@media (max-width: 1100px) { .sp-grid { grid-template-columns: repeat(2, 1fr); } }
    @@media (max-width: 900px) {
        .sp-layout { grid-template-columns: 1fr; }
        .sp-filter { position: static; }
    }
    @@media (max-width: 576px) { .sp-grid { grid-template-columns: 1fr; } }
</style>

<div class="container sp-page">

    <div class="sp-crumb">
        <a asp-controller="Home" asp-action="Index"><i class="bi bi-house-door"></i> Trang chủ</a>
        &nbsp;/&nbsp; <b>Tất cả sản phẩm</b>
    </div>

    <h1 class="sp-title">Tất cả sản phẩm</h1>
    <p class="sp-subtitle">Hiển thị <b id="spShown">@dsSanPham.Count</b> trong <b>@dsSanPham.Count</b> sản phẩm công nghệ chính hãng</p>

    <div class="sp-layout">

        <!-- ===== BỘ LỌC ===== -->
        <aside class="sp-filter">
            <div class="sp-filter-head">
                <h5><i class="bi bi-funnel"></i> Bộ lọc sản phẩm</h5>
                <button type="button" class="sp-reset" id="spReset"><i class="bi bi-arrow-counterclockwise"></i> Đặt lại</button>
            </div>

            <div class="sp-fgroup">
                <div class="sp-ftitle">Danh mục sản phẩm</div>
                @foreach (var dm in dsDanhMuc)
                {
                    <label class="sp-check">
                        <input type="checkbox" class="f-cat" value="@dm.Ten" />
                        @dm.Ten
                        <span class="cnt">@dm.SoLuong</span>
                    </label>
                }
            </div>

            <div class="sp-fgroup">
                <div class="sp-ftitle">Khoảng giá</div>
                <label class="sp-check"><input type="radio" name="fPrice" class="f-price" data-min="0" data-max="0" checked /> Tất cả mức giá</label>
                <label class="sp-check"><input type="radio" name="fPrice" class="f-price" data-min="0" data-max="5000000" /> Dưới 5 triệu</label>
                <label class="sp-check"><input type="radio" name="fPrice" class="f-price" data-min="5000000" data-max="10000000" /> 5 – 10 triệu</label>
                <label class="sp-check"><input type="radio" name="fPrice" class="f-price" data-min="10000000" data-max="20000000" /> 10 – 20 triệu</label>
                <label class="sp-check"><input type="radio" name="fPrice" class="f-price" data-min="20000000" data-max="30000000" /> 20 – 30 triệu</label>
                <label class="sp-check"><input type="radio" name="fPrice" class="f-price" data-min="30000000" data-max="0" /> Trên 30 triệu</label>
            </div>

            <div class="sp-fgroup">
                <div class="sp-ftitle">Tình trạng hàng</div>
                <label class="sp-check"><input type="checkbox" class="f-stock" value="con" /> Còn hàng</label>
                <label class="sp-check"><input type="checkbox" class="f-stock" value="het" /> Hết hàng</label>
            </div>

            <button type="button" class="sp-btn-apply" id="spApply"><i class="bi bi-funnel-fill"></i> Áp dụng bộ lọc</button>
            <button type="button" class="sp-btn-clear" id="spClear">Xóa bộ lọc</button>
        </aside>

        <!-- ===== DANH SÁCH ===== -->
        <div>
            <div class="sp-toolbar">
                <div class="sp-chips" id="spChips">
                    <span>Đang lọc:</span>
                    <span class="sp-chip"><i class="bi bi-grid"></i> Tất cả</span>
                </div>
                <div class="sp-sort">
                    Sắp xếp theo:
                    <select id="spSort">
                        <option value="default">Mặc định</option>
                        <option value="price-asc">Giá tăng dần</option>
                        <option value="price-desc">Giá giảm dần</option>
                        <option value="name-asc">Tên A → Z</option>
                    </select>
                </div>
            </div>

            <div class="sp-grid" id="spGrid">
                @{ int stt = 0; }
                @foreach (var item in dsSanPham)
                {
                    <div class="sp-item"
                         data-index="@(stt++)"
                         data-cat="@(item.Category?.CategoryName ?? "Khác")"
                         data-price="@((long)item.Price)"
                         data-stock="@(item.Stock > 0 ? "con" : "het")"
                         data-name="@item.ProductName">
                        <div class="sp-card h-100">
                            <a asp-action="ChiTiet" asp-route-id="@item.ProductID" class="sp-thumb">
                                @if (item.Stock > 0)
                                {
                                    <span class="sp-badge">Chính hãng</span>
                                }
                                else
                                {
                                    <span class="sp-badge out">Tạm hết</span>
                                }
                                <img src="@LayAnh(item.ImageURL)"
                                     onerror="this.onerror=null;this.src='/images/no-image.png'"
                                     alt="@item.ProductName" />
                            </a>

                            <div class="sp-body">
                                <div class="sp-meta">
                                    <span class="sp-cat">@(item.Category?.CategoryName ?? "Khác")</span>
                                    @if (item.Stock > 0)
                                    {
                                        <span class="sp-stock">Còn hàng</span>
                                    }
                                    else
                                    {
                                        <span class="sp-stock out">Hết hàng</span>
                                    }
                                </div>

                                <h5 class="sp-name">
                                    <a asp-action="ChiTiet" asp-route-id="@item.ProductID">@item.ProductName</a>
                                </h5>

                                <div class="sp-desc">
                                    @if (!string.IsNullOrEmpty(item.Description))
                                    {
                                        @(item.Description.Length > 80 ? item.Description.Substring(0, 80) + "..." : item.Description)
                                    }
                                    else
                                    {
                                        <span>Sản phẩm công nghệ chính hãng.</span>
                                    }
                                </div>

                                <div class="sp-price-row">
                                    <span class="sp-price">@item.Price.ToString("N0")đ</span>
                                    @if (item.Stock > 0)
                                    {
                                        <span class="sp-qty">Tồn kho: @item.Stock</span>
                                    }
                                </div>
                            </div>

                            <div class="sp-foot">
                                @if (item.Stock > 0)
                                {
                                    <form asp-controller="GioHang" asp-action="ThemVaoGio" method="post">
                                        <input type="hidden" name="maSanPham" value="@item.ProductID" />
                                        <input type="hidden" name="soLuong" value="1" />
                                        <button type="submit" class="sp-btn cart">
                                            <i class="bi bi-cart3"></i> Thêm vào giỏ
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <button type="button" class="sp-btn disabled" disabled>Hết hàng</button>
                                }
                                <a asp-action="ChiTiet" asp-route-id="@item.ProductID" class="sp-btn detail" title="Xem chi tiết">
                                    <i class="bi bi-eye"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <div class="sp-empty" id="spEmpty">
                <i class="bi bi-search"></i>
                Không có sản phẩm nào phù hợp. Hãy thử xóa bớt bộ lọc.
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            var grid = document.getElementById('spGrid');
            var items = Array.prototype.slice.call(grid.querySelectorAll('.sp-item'));
            var empty = document.getElementById('spEmpty');
            var shown = document.getElementById('spShown');
            var chips = document.getElementById('spChips');
            var sortSel = document.getElementById('spSort');

            function layBoLoc() {
                var cats = Array.prototype.slice.call(document.querySelectorAll('.f-cat:checked')).map(function (x) { return x.value; });
                var stocks = Array.prototype.slice.call(document.querySelectorAll('.f-stock:checked')).map(function (x) { return x.value; });
                var p = document.querySelector('.f-price:checked');
                return {
                    cats: cats,
                    stocks: stocks,
                    min: p ? parseInt(p.dataset.min) : 0,
                    max: p ? parseInt(p.dataset.max) : 0,
                    priceText: p ? p.parentNode.textContent.trim() : ''
                };
            }

            function apDung() {
                var f = layBoLoc();
                var dem = 0;

                items.forEach(function (el) {
                    var price = parseInt(el.dataset.price);
                    var ok = true;
                    if (f.cats.length && f.cats.indexOf(el.dataset.cat) === -1) ok = false;
                    if (f.stocks.length && f.stocks.indexOf(el.dataset.stock) === -1) ok = false;
                    if (f.min && price < f.min) ok = false;
                    if (f.max && price >= f.max) ok = false;
                    el.style.display = ok ? '' : 'none';
                    if (ok) dem++;
                });

                shown.textContent = dem;
                empty.style.display = dem === 0 ? 'block' : 'none';

                // Vẽ lại các chip đang lọc
                var html = '<span>Đang lọc:</span>';
                var coChip = false;
                f.cats.forEach(function (c) { html += '<span class="sp-chip">' + esc(c) + '</span>'; coChip = true; });
                if (f.min || f.max) { html += '<span class="sp-chip">' + esc(f.priceText) + '</span>'; coChip = true; }
                f.stocks.forEach(function (s) { html += '<span class="sp-chip">' + (s === 'con' ? 'Còn hàng' : 'Hết hàng') + '</span>'; coChip = true; });
                if (!coChip) html += '<span class="sp-chip"><i class="bi bi-grid"></i> Tất cả</span>';
                chips.innerHTML = html;
            }

            function esc(s) {
                var d = document.createElement('div');
                d.textContent = s;
                return d.innerHTML;
            }

            function sapXep() {
                var kieu = sortSel.value;
                var arr = items.slice();
                arr.sort(function (a, b) {
                    if (kieu === 'price-asc') return a.dataset.price - b.dataset.price;
                    if (kieu === 'price-desc') return b.dataset.price - a.dataset.price;
                    if (kieu === 'name-asc') return a.dataset.name.localeCompare(b.dataset.name, 'vi');
                    return a.dataset.index - b.dataset.index;
                });
                arr.forEach(function (el) { grid.appendChild(el); });
            }

            function datLai() {
                document.querySelectorAll('.f-cat, .f-stock').forEach(function (x) { x.checked = false; });
                var all = document.querySelector('.f-price');
                if (all) all.checked = true;
                sortSel.value = 'default';
                sapXep();
                apDung();
            }

            document.getElementById('spApply').addEventListener('click', apDung);
            document.getElementById('spClear').addEventListener('click', datLai);
            document.getElementById('spReset').addEventListener('click', datLai);
            sortSel.addEventListener('change', sapXep);
        })();
    </script>
}